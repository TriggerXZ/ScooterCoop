---
import "../styles/global.css";
import SchemaOrg from "../components/SchemaOrg.astro";
import MemphisNav from "../components/MemphisNav.astro";

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schemaType?: "website" | "product";
}

const {
  title,
  description = "Alquiler de scooters eléctricos en el Malecón de Barranquilla - ScooterCoop",
  canonical = Astro.url.pathname,
  schemaType = "website",
} = Astro.props;

const canonicalURL = new URL(canonical, Astro.site || "https://scootercoop.com").toString();
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
<head>
  <SchemaOrg type={schemaType} />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <meta name="keywords" content="scooter, scootercoop, patinetas eléctricas, alquiler de scooters, Malecón, Barranquilla, movilidad eléctrica" />
  <meta name="author" content="ScooterCoop" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={`${title} | ScooterCoop`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/logo.png" />
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={`${title} | ScooterCoop`} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content="/logo.png" />
  <title>{title} | ScooterCoop - Scooters en el Malecón</title>
  <link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" />
</head>
<body class="site-body">
  <!-- Navigation -->
  <MemphisNav currentPath={currentPath} />

  <main class="min-h-screen pt-16 md:pt-20 bg-cream">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="footer-memphis">
    <div class="footer-pattern"></div>

    <div class="container mx-auto px-4 py-16 relative z-10">
      <div class="footer-grid">
        <!-- Logo & Description -->
        <div class="footer-brand">
          <a href="/" class="footer-logo">
            <picture>
              <source srcset="/logo2.png" media="(prefers-color-scheme: dark)">
              <img src="/logo.png" alt="ScooterCoop" class="footer-logo-img">
            </picture>
            <span class="logo-text">ScooterCoop</span>
          </a>
          <p class="footer-description">
            Explora el Malecón de Barranquilla con estilo y sostenibilidad. La mejor experiencia en scooters eléctricos.
          </p>
          <div class="social-buttons">
            <a href="https://instagram.com/scootercoop" target="_blank" class="social-btn" aria-label="Instagram">
              <i class="bx bxl-instagram"></i>
            </a>
            <a href="https://facebook.com/scootercoop" target="_blank" class="social-btn" aria-label="Facebook">
              <i class="bx bxl-facebook"></i>
            </a>
            <a href="https://wa.me/573001234567" target="_blank" class="social-btn" aria-label="WhatsApp">
              <i class="bx bxl-whatsapp"></i>
            </a>
          </div>
        </div>

        <!-- Contact -->
        <div class="footer-section">
          <h4 class="footer-heading">Contacto</h4>
          <ul class="footer-list">
            <li class="footer-list-item">
              <i class="bx bx-map"></i>
              <span>Malecón del Río, Barranquilla</span>
            </li>
            <li class="footer-list-item">
              <i class="bx bx-phone"></i>
              <span>+57 300 123 4567</span>
            </li>
            <li class="footer-list-item">
              <i class="bx bx-envelope"></i>
              <span>info@scootercoop.com</span>
            </li>
          </ul>
        </div>

        <!-- Schedule -->
        <div class="footer-section">
          <h4 class="footer-heading">Horario</h4>
          <ul class="footer-list">
            <li>
              <div class="schedule-day">
                <i class="bx bx-calendar-week"></i>
                <span class="text-text font-semibold">Lunes a Viernes</span>
              </div>
              <div class="schedule-time">15:00 - 22:00</div>
            </li>
            <li>
              <div class="schedule-day">
                <i class="bx bx-calendar"></i>
                <span class="text-text font-semibold">Sábado y Domingo</span>
              </div>
              <div class="schedule-time">14:00 - 23:00</div>
            </li>
          </ul>
        </div>

        <!-- Quick Links -->
        <div class="footer-section">
          <h4 class="footer-heading">Enlaces</h4>
          <ul class="footer-list footer-links">
            <li><a href="/servicios">Servicios</a></li>
            <li><a href="/precios">Precios</a></li>
            <li><a href="/experiencias">Experiencias</a></li>
            <li><a href="/galeria">Galería</a></li>
            <li><a href="/contacto">Contacto</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <div class="footer-deco footer-deco-1"></div>
        <div class="footer-deco footer-deco-2"></div>
        <p class="copyright">&copy; {new Date().getFullYear()} ScooterCoop. Todos los derechos reservados.</p>
      </div>
    </div>
</footer>
</body>
</html>

<style is:global>
  /* Base Site Body */
  .site-body {
    font-family: 'Nunito', sans-serif;
    color: var(--color-text);
    background-color: var(--color-cream);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  .memphis-header {
    background-color: var(--color-cream);
  }

  /* Footer Styles */
.footer-memphis {
  position: relative;
  background-color: var(--bg-footer);
  color: var(--text-footer);
  overflow: hidden;
}

.footer-pattern {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: repeating-linear-gradient(
    -45deg,
    rgba(255, 107, 157, 0.05),
    rgba(255, 107, 157, 0.05) 10px,
    transparent 10px,
    transparent 20px
  );
}

.footer-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}

@media (min-width: 768px) {
  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .footer-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.footer-brand {
  grid-column: span 1;
}

.footer-logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1rem;
}

.footer-logo-img {
  height: 40px;
  width: auto;
}

.logo-text {
  font-family: 'Fredoka One', cursive;
  font-size: 1.5rem;
  color: var(--text-footer);
}

.footer-description {
  font-family: 'Nunito', sans-serif;
  color: var(--color-gray-400);
  font-size: 0.875rem;
  margin-bottom: 1.5rem;
  line-height: 1.6;
}

.social-buttons {
  display: flex;
  gap: 0.75rem;
}

.social-btn {
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 9999px;
  border: 2px solid var(--text-footer);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-footer);
  transition: all 0.2s ease;
}

.social-btn:hover {
  background-color: #FFE135;
  border-color: #FFE135;
  color: #2D2D2D;
  transform: scale(1.1);
}

.social-btn i {
  font-size: 1.125rem;
}

.footer-section {
  display: flex;
  flex-direction: column;
}

.footer-heading {
  font-family: 'Fredoka One', cursive;
  font-size: 1.125rem;
  color: var(--text-footer);
  margin-bottom: 1rem;
  position: relative;
}

.footer-heading::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 2rem;
  height: 0.25rem;
  background-color: #FF6B9D;
  border-radius: 9999px;
}

.footer-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  font-size: 0.875rem;
  color: var(--color-gray-400);
}

.footer-list-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.footer-list-item i {
  color: #FF6B9D;
}

.schedule-day {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.25rem;
}

.schedule-day i {
  color: #00ADEE;
}

.schedule-time {
  font-family: 'Fredoka One', cursive;
  color: #FFE135;
  font-size: 1.125rem;
  margin-left: 1.5rem;
}

.footer-links {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.footer-links a {
  color: var(--color-gray-400);
  transition: color 0.2s ease;
}

.footer-links a:hover {
  color: #FF6B9D;
}

.footer-bottom {
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  text-align: center;
  position: relative;
}

.footer-deco {
  position: absolute;
  pointer-events: none;
  border-radius: 9999px;
}

.footer-deco-1 {
  width: 4rem;
  height: 4rem;
  background-color: #FFE135;
  bottom: -8px;
  left: 20%;
  opacity: 0.15;
}

.footer-deco-2 {
  width: 3rem;
  height: 3rem;
  background-color: #FF6B9D;
  top: -6px;
  right: 25%;
  opacity: 0.1;
}

.copyright {
  font-family: 'Nunito', sans-serif;
  font-size: 0.875rem;
  color: var(--color-gray-500);
}

/* Additional Memphis Utilities */
.container {
  max-width: 80rem;
  margin-left: auto;
  margin-right: auto;
  padding-left: 1rem;
  padding-right: 1rem;
}

.pt-20 {
  padding-top: 5rem;
}
</style>