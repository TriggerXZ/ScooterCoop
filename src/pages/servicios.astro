---
import Layout from "../layouts/Layout.astro";
import MemphisCard from "../components/MemphisCard.astro";
import MemphisButton from "../components/MemphisButton.astro";
---

<Layout title="Servicios" description="Conoce nuestros servicios de alquiler de scooters eléctricos en el Malecón de Barranquilla">
  <!-- Hero Section -->
  <section class="hero-memphis">
    <div class="hero-pattern"></div>
    <div class="hero-deco hero-deco-1"></div>
    <div class="hero-deco hero-deco-2"></div>

    <div class="container mx-auto px-4 py-32 relative z-10">
      <h1 class="hero-title-memphis text-center">
        NUESTROS<br/>
        <span class="text-lime">SERVICIOS</span>
      </h1>
      <p class="hero-desc-memphis text-center">Tecnología, seguridad y diversión en cada trayecto por el Malecón</p>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-24 bg-cream">
    <div class="container mx-auto px-4">
      <div class="services-grid-memphis">
        <!-- Service 1: Alquiler por Tiempo -->
        <MemphisCard variant="blue" class="service-card-memphis" data-aos="fade-up" data-aos-delay="100">
          <div class="service-header-memphis">
            <div class="service-icon-memphis service-icon-blue">
              <i class="bx bx-time text-3xl"></i>
            </div>
            <span class="service-badge-memphis service-badge-blue">POPULAR</span>
          </div>
          <h2 class="service-title-memphis">ALQUILER POR TIEMPO</h2>
          <p class="service-desc-memphis">Recorre el Malecón a tu ritmo con scooters eléctricos de última generación.</p>

          <div class="service-options-memphis">
            <div class="option-item-memphis">
              <span class="option-time">30 min</span>
              <span class="option-price text-blue font-bold">$25.000</span>
            </div>
            <div class="option-item-memphis">
              <span class="option-time">40 min</span>
              <span class="option-price text-blue font-bold">$30.000</span>
            </div>
            <div class="option-item-memphis">
              <span class="option-time">60 min</span>
              <span class="option-price text-blue font-bold">$40.000</span>
            </div>
          </div>

          <div class="service-includes-memphis">
            <h4 class="includes-title-memphis"><i class="bx bx-check-circle text-blue"></i> Incluye</h4>
            <ul class="includes-list-memphis">
              <li><i class="bx bx-helmet text-blue"></i> Casco de seguridad</li>
              <li><i class="bx bx-user-voice text-blue"></i> Inducción técnica</li>
              <li><i class="bx bx-map text-blue"></i> Guía de puntos turísticos</li>
            </ul>
          </div>

          <MemphisButton href="/contacto?servicio=alquiler" variant="primary" class="w-full">RESERVAR</MemphisButton>
        </MemphisCard>

        <!-- Service 2: Tours Grupales -->
        <MemphisCard variant="yellow" class="service-card-memphis" data-aos="fade-up" data-aos-delay="200">
          <div class="service-header-memphis">
            <div class="service-icon-memphis service-icon-yellow">
              <i class="bx bx-group text-3xl"></i>
            </div>
            <span class="service-badge-memphis service-badge-yellow">GRUPOS</span>
          </div>
          <h2 class="service-title-memphis">TOURS GUIADOS</h2>
          <p class="service-desc-memphis">Recorridos exclusivos con guía turístico por los puntos más icónicos.</p>

          <div class="service-options-memphis">
            <div class="option-item-memphis">
              <span class="option-time">Cultura</span>
              <span class="option-price text-yellow font-bold">$35.000</span>
            </div>
            <div class="option-item-memphis">
              <span class="option-time">Atardecer</span>
              <span class="option-price text-yellow font-bold">$40.000</span>
            </div>
            <div class="option-item-memphis">
              <span class="option-time">Completa</span>
              <span class="option-price text-yellow font-bold">$50.000</span>
            </div>
          </div>

          <div class="service-includes-memphis">
            <h4 class="includes-title-memphis"><i class="bx bx-check-circle text-yellow"></i> Incluye</h4>
            <ul class="includes-list-memphis">
              <li><i class="bx bx-camera text-yellow"></i> Fotos profesionales</li>
              <li><i class="bx bx-bookmark text-yellow"></i> Souvenir digital</li>
              <li><i class="bx bx-water text-yellow"></i> Agua refrescante</li>
            </ul>
          </div>

          <MemphisButton href="/contacto?servicio=tour" variant="primary" class="w-full">RESERVAR</MemphisButton>
        </MemphisCard>

        <!-- Service 3: Eventos -->
        <MemphisCard variant="coral" class="service-card-memphis" data-aos="fade-up" data-aos-delay="300">
          <div class="service-header-memphis">
            <div class="service-icon-memphis service-icon-coral">
              <i class="bx bx-party text-3xl"></i>
            </div>
            <span class="service-badge-memphis service-badge-coral">ESPECIAL</span>
          </div>
          <h2 class="service-title-memphis">EVENTOS ESPECIALES</h2>
          <p class="service-desc-memphis">Celebra cumpleaños, despedidas y eventos corporativos con estilo único.</p>

          <div class="service-options-memphis">
            <div class="option-item-memphis">
              <span class="option-time">Cumpleaños</span>
              <span class="option-price text-coral font-bold">Cotizar</span>
            </div>
            <div class="option-item-memphis">
              <span class="option-time">Despedidas</span>
              <span class="option-price text-coral font-bold">Cotizar</span>
            </div>
            <div class="option-item-memphis">
              <span class="option-time">Corporativo</span>
              <span class="option-price text-coral font-bold">Cotizar</span>
            </div>
          </div>

          <div class="service-includes-memphis">
            <h4 class="includes-title-memphis"><i class="bx bx-check-circle text-coral"></i> Incluye</h4>
            <ul class="includes-list-memphis">
              <li><i class="bx bx-star text-coral"></i> Personalización</li>
              <li><i class="bx bx-video text-coral"></i> Cobertura en video</li>
              <li><i class="bx bx-gift text-coral"></i> Souvenirs únicos</li>
            </ul>
          </div>

          <MemphisButton href="/contacto?servicio=evento" variant="accent" class="w-full">COTIZAR</MemphisButton>
        </MemphisCard>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 bg-cream">
    <div class="container mx-auto px-4">
      <h2 class="section-title text-center mb-12">PREGUNTAS FRECUENTES</h2>

      <div class="faq-grid-memphis">
        <div class="faq-item-memphis" data-aos="fade-up" data-aos-delay="100">
          <div class="faq-icon-memphis faq-icon-blue"><i class="bx bx-help-circle"></i></div>
          <div>
            <h3 class="faq-question-memphis">¿Necesito experiencia previa?</h3>
            <p class="faq-answer-memphis">No, nuestros scooters son muy fáciles de manejar y te damos una inducción completa antes de iniciar.</p>
          </div>
        </div>

        <div class="faq-item-memphis" data-aos="fade-up" data-aos-delay="150">
          <div class="faq-icon-memphis faq-icon-blue"><i class="bx bx-id-card"></i></div>
          <div>
            <h3 class="faq-question-memphis">¿Qué documentos necesito?</h3>
            <p class="faq-answer-memphis">Solo tu documento de identidad (cédula o pasaporte) y firmar el formulario de responsabilidad.</p>
          </div>
        </div>

        <div class="faq-item-memphis" data-aos="fade-up" data-aos-delay="200">
          <div class="faq-icon-memphis faq-icon-yellow"><i class="bx bx-user"></i></div>
          <div>
            <h3 class="faq-question-memphis">¿Hay límite de edad?</h3>
            <p class="faq-answer-memphis">Debes ser mayor de 12 años. Los menores pueden conducir bajo supervisión de un adulto.</p>
          </div>
        </div>

        <div class="faq-item-memphis" data-aos="fade-up" data-aos-delay="250">
          <div class="faq-icon-memphis faq-icon-pink"><i class="bx bx-credit-card"></i></div>
          <div>
            <h3 class="faq-question-memphis">¿Métodos de pago?</h3>
            <p class="faq-answer-memphis">Aceptamos efectivo, Nequi, Daviplata, tarjetas de crédito/débito y transferencias.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 relative overflow-hidden bg-cream">
    <div class="cta-deco-memphis cta-deco-1"></div>
    <div class="cta-deco-memphis cta-deco-2"></div>
    <div class="cta-deco-memphis cta-deco-3"></div>

    <div class="container mx-auto px-4 text-center relative z-10">
      <h2 class="section-title">¿LISTO PARA EXPLORAR?</h2>
      <p class="section-subtitle mt-4">Reserva tu scooter y descubre el Malecón</p>
      <div class="mt-10">
        <MemphisButton href="/contacto" variant="primary" size="lg">RESERVAR AHORA</MemphisButton>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-memphis {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: center;
    background-color: var(--color-cream);
    overflow: hidden;
  }

  .hero-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--color-text-dots) 2px, transparent 2px);
    background-size: 20px 20px;
    opacity: 0.3;
  }

  @media (prefers-color-scheme: dark) {
    .hero-memphis {
      background-color: var(--color-cream);
    }

    .hero-pattern {
      --color-text-dots: rgba(245,245,245,0.15);
    }
  }

  :root {
    --color-text-dots: rgba(45,45,45,0.05);
  }

.hero-deco {
  @apply absolute pointer-events-none rounded-full;
}

.hero-deco-1 {
  @apply w-32 h-32 rounded-full bg-lime;
  top: 10%;
  right: 15%;
  opacity: 0.2;
}

.hero-deco-2 {
  @apply w-20 h-20 rounded-full bg-yellow;
  bottom: 15%;
  left: 10%;
  opacity: 0.25;
}

.hero-title-memphis {
    @apply font-heading text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-4;
    color: var(--color-text);
  }

  .hero-desc-memphis {
    @apply font-body text-lg;
    color: var(--color-gray-600);
  }

.services-grid-memphis {
  @apply grid grid-cols-1 md:grid-cols-3 gap-8;
}

.service-card-memphis {
  @apply p-6;
}

.service-header-memphis {
  @apply flex justify-between items-start mb-4;
}

.service-icon-memphis {
  @apply w-14 h-14 flex items-center justify-center border-4 border-solid rounded-full;
}

.service-icon-blue {
  @apply border-blue text-blue;
}

.service-icon-yellow {
  @apply border-yellow text-yellow;
}

.service-icon-coral {
  @apply border-coral text-coral;
}

.service-badge-memphis {
  @apply font-subheading font-bold text-xs px-3 py-1 rounded-full;
}

.service-badge-blue {
  @apply bg-blue text-white;
}

.service-badge-yellow {
    @apply bg-yellow;
    color: var(--color-text);
  }

  .service-badge-coral {
    @apply bg-coral text-white;
  }

  .service-title-memphis {
    @apply font-heading text-xl font-bold mb-2;
    color: var(--color-text);
  }

  .service-desc-memphis {
    @apply font-body mb-4;
    color: var(--color-gray-600);
  }

.service-options-memphis {
    @apply space-y-2 mb-4 pb-4 border-b-2 border-dashed border-gray-200;
  }

  @media (prefers-color-scheme: dark) {
    .service-options-memphis {
      @apply border-gray-600;
    }
  }

.option-item-memphis {
  @apply flex justify-between items-center p-3 bg-cream rounded-lg border-2 border-dashed border-gray-200;
}

.option-time {
    @apply font-body text-sm;
    color: var(--color-text);
  }

  .option-price {
    @apply font-heading text-lg;
  }

  .service-includes-memphis {
    @apply mb-6;
  }

  .includes-title-memphis {
    @apply font-subheading font-bold text-sm mb-2 flex items-center gap-2;
    color: var(--color-text);
  }

  .includes-list-memphis {
    @apply list-none p-0 m-0 space-y-1;
  }

  .includes-list-memphis li {
    @apply flex items-center gap-2 font-body text-sm;
    color: var(--color-gray-600);
  }

.faq-grid-memphis {
  @apply grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto;
}

.faq-item-memphis {
    @apply flex gap-4 p-6 bg-white border-4 border-solid border-text rounded-lg;
    box-shadow: 6px 6px 0 var(--shadow-color);
  }

  @media (prefers-color-scheme: dark) {
    .faq-item-memphis {
      box-shadow: 6px 6px 0 rgba(255, 255, 255, 0.1);
    }
  }

.faq-icon-memphis {
  @apply w-12 h-12 flex items-center justify-center border-4 border-solid rounded-full flex-shrink-0;
}

.faq-icon-blue {
  @apply border-blue text-blue;
}

.faq-icon-yellow {
  @apply border-yellow text-yellow;
}

.faq-icon-pink {
  @apply border-pink text-pink;
}

.faq-question-memphis {
    @apply font-heading text-lg mb-2;
    color: var(--color-text);
  }

  .faq-answer-memphis {
    @apply font-body text-sm;
    color: var(--color-gray-600);
  }

.cta-deco-memphis {
  @apply absolute pointer-events-none rounded-full;
}

.cta-deco-1 {
  @apply w-40 h-40 rounded-full bg-yellow;
  top: -20px;
  left: 10%;
  opacity: 0.15;
}

.cta-deco-2 {
  @apply w-24 h-24 rounded-full bg-pink;
  bottom: 20%;
  right: 15%;
  opacity: 0.1;
}

.cta-deco-3 {
  @apply w-16 h-16 rounded-full bg-blue;
  top: 40%;
  right: 5%;
  opacity: 0.12;
}
</style>