---
import Layout from "../layouts/Layout.astro";
import MemphisButton from "../components/MemphisButton.astro";
---

<Layout title="¡Gracias por tu reserva!">
<section class="thanks-memphis">
  <div class="thanks-deco thanks-deco-1"></div>
  <div class="thanks-deco thanks-deco-2"></div>
  <div class="thanks-pattern"></div>

  <div class="container mx-auto px-4 py-16 relative z-10">
    <div class="thanks-card-memphis text-center max-w-2xl mx-auto">
      <div class="success-icon-memphis">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="check-icon">
          <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <h1 class="thanks-title-memphis">¡Reserva Confirmada!</h1>

      <p class="thanks-desc-memphis">
        Tu scooter te está esperando. Llegaste más rápido que un scooter a toda potencia.
      </p>

      <div class="thanks-info-memphis">
        <div class="info-item">
          <i class="bx bx-map"></i>
          <span>Encuéntranos en el Malecón del Río</span>
        </div>
        <div class="info-item">
          <i class="bx bx-time"></i>
          <span>Horario: 3:00 PM - 10:00 PM</span>
        </div>
        <div class="info-item">
          <i class="bx bx-phone"></i>
          <span>+57 300 123 4567</span>
        </div>
      </div>

      <div class="thanks-buttons-memphis">
        <MemphisButton href="/" variant="primary" size="lg">
          <i class="bx bx-home"></i>
          Volver al Inicio
        </MemphisButton>
        <MemphisButton href="/contacto" variant="secondary" size="lg">
          <i class="bx bx-help-circle"></i>
          ¿Dudas? Contáctanos
        </MemphisButton>
      </div>
    </div>
  </div>
</section>
</Layout>

<style>
.thanks-memphis {
  position: relative;
  min-height: calc(100vh - 80px);
  display: flex;
  align-items: center;
}

.thanks-deco {
  position: absolute;
  pointer-events: none;
  border-radius: 9999px;
}

.thanks-deco-1 {
  width: 16rem;
  height: 16rem;
  border-radius: 9999px;
  background-color: #FFE135;
  top: 10%;
  left: -10%;
  opacity: 0.2;
}

.thanks-deco-2 {
  width: 12rem;
  height: 12rem;
  border-radius: 9999px;
  background-color: #FF6B9D;
  bottom: 10%;
  right: -5%;
  opacity: 0.15;
}

.thanks-pattern {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle, #FF6B9D 3px, transparent 3px);
  background-size: 24px 24px;
  opacity: 0.2;
}

.thanks-card-memphis {
    background-color: var(--color-white);
    border: 4px solid #39FF14;
    padding: 3rem;
    box-shadow: 12px 12px 0 rgba(0, 0, 0, 0.1);
    animation: drop-in 0.5s ease-out;
  }

  @media (prefers-color-scheme: dark) {
    .thanks-card-memphis {
      box-shadow: 12px 12px 0 rgba(255, 255, 255, 0.1);
    }
  }

  .success-icon-memphis {
    width: 6rem;
    height: 6rem;
    border-radius: 9999px;
    background-color: #39FF14;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 2rem;
    box-shadow: 6px 6px 0 #1A1A2E;
  }

  .check-icon {
    width: 3rem;
    height: 3rem;
    color: #1A1A2E;
  }

  .thanks-title-memphis {
    font-family: 'Fredoka One', cursive;
    font-size: 2.5rem;
    font-weight: bold;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .thanks-desc-memphis {
    font-family: 'Nunito', sans-serif;
    font-size: 1.25rem;
    color: var(--color-gray-600);
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .thanks-info-memphis {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
    padding: 1.5rem;
    background-color: var(--color-cream);
    border: 2px dashed var(--color-text);
  }

  .info-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: 'Nunito', sans-serif;
    color: var(--color-text);
  }

.info-item i {
  font-size: 1.25rem;
  color: #FF6B9D;
}

.thanks-buttons-memphis {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  justify-content: center;
}

@media (min-width: 640px) {
  .thanks-buttons-memphis {
    flex-direction: row;
  }
}

@keyframes drop-in {
  0% {
    opacity: 0;
    transform: translateY(-30px) scale(0.9);
  }
  70% {
    transform: translateY(5px) scale(1.02);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
</style>