---
import Layout from "../layouts/Layout.astro";
import MemphisButton from "../components/MemphisButton.astro";

const galleryImages = [
  { src: "/paisaje.jpg", category: "malecon", title: "Paisaje del Malecón", desc: "Vista panorámica del Malecón", tag: "MALECÓN" },
  { src: "/monumentotiburon.jpg", category: "cultura", title: "Monumento Tiburón", desc: "Homenaje al Junior de Barranquilla", tag: "CULTURA" },
  { src: "/atardecer.jpg", category: "experiencias", title: "Atardecer Mágico", desc: "Los colores del Caribe", tag: "EXPERIENCIAS" },
  { src: "/equipo.jpg", category: "equipo", title: "Nuestro Equipo", desc: "Equipo profesional", tag: "EQUIPO" },
  { src: "/mapa.jpg", category: "malecon", title: "Ubicación", desc: "En el Malecón del Río", tag: "MALECÓN" },
  { src: "/atardecer.jpg", category: "experiencias", title: "Ruta Completa", desc: "Explora todo el Malecón", tag: "EXPERIENCIAS" },
  { src: "/monumentotiburon.jpg", category: "cultura", title: "Cultura Barranquillera", desc: "Tradición y deporte", tag: "CULTURA" },
  { src: "/paisaje.jpg", category: "malecon", title: "Atardecer en el Río", desc: "Magia del Magdalena", tag: "MALECÓN" },
];
---

<Layout title="Galería" description="Galería de fotos de nuestros scooters eléctricos y experiencias en el Malecón de Barranquilla">
  <!-- Hero Section -->
  <section class="hero-memphis">
    <div class="hero-pattern"></div>
    <div class="hero-deco hero-deco-1"></div>
    <div class="hero-deco hero-deco-2"></div>

    <div class="container mx-auto px-4 py-32 relative z-10 text-center">
      <h1 class="hero-title-memphis">
        GALERÍA<br/>
        <span class="text-pink">SCOOTERCOOP</span>
      </h1>
      <p class="hero-desc-memphis">Captura los mejores momentos de tu experiencia en el Malecón</p>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-6 bg-cream border-b-4 border-dashed border-text">
    <div class="container mx-auto px-4">
      <div class="flex flex-wrap justify-center gap-4">
        <button class="filter-btn-memphis active" data-filter="todos">Todos</button>
        <button class="filter-btn-memphis" data-filter="malecon">Malecón</button>
        <button class="filter-btn-memphis" data-filter="cultura">Cultura</button>
        <button class="filter-btn-memphis" data-filter="experiencias">Experiencias</button>
        <button class="filter-btn-memphis" data-filter="equipo">Equipo</button>
      </div>
    </div>
  </section>

  <!-- Gallery Grid -->
  <section class="py-16 bg-cream">
    <div class="container mx-auto px-4">
      <div class="gallery-grid-memphis" id="galleryGrid">
        {galleryImages.map((img, index) => (
          <div class="gallery-item-memphis" data-category={img.category} style={`animation-delay: ${index * 100}ms`}>
            <div class="gallery-image-container-memphis">
              <img src={img.src} alt={img.title} class="gallery-image-memphis" />
              <div class="gallery-overlay-memphis">
                <span class="gallery-tag-memphis">{img.tag}</span>
                <div class="gallery-info-memphis">
                  <h3>{img.title}</h3>
                  <p>{img.desc}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Instagram Section -->
  <section class="instagram-section-memphis py-16">
    <div class="instagram-deco"></div>
    <div class="container mx-auto text-center px-4 relative z-10">
      <h2 class="instagram-title-memphis">
        <i class="bx bxl-instagram"></i>
        Síguenos en Instagram
      </h2>
      <p class="instagram-desc-memphis">@scootercoop_</p>

      <div class="insta-grid-memphis">
        <a href="https://instagram.com/scootercoop_" target="_blank" class="insta-post-memphis">
          <img src="/paisaje.jpg" alt="Instagram post" />
          <div class="insta-overlay-memphis">
            <i class="bx bxl-instagram"></i>
          </div>
        </a>
        <a href="https://instagram.com/scootercoop_" target="_blank" class="insta-post-memphis">
          <img src="/atardecer.jpg" alt="Instagram post" />
          <div class="insta-overlay-memphis">
            <i class="bx bxl-instagram"></i>
          </div>
        </a>
        <a href="https://instagram.com/scootercoop_" target="_blank" class="insta-post-memphis">
          <img src="/monumentotiburon.jpg" alt="Instagram post" />
          <div class="insta-overlay-memphis">
            <i class="bx bxl-instagram"></i>
          </div>
        </a>
        <a href="https://instagram.com/scootercoop_" target="_blank" class="insta-post-memphis">
          <img src="/equipo.jpg" alt="Instagram post" />
          <div class="insta-overlay-memphis">
            <i class="bx bxl-instagram"></i>
          </div>
        </a>
        <a href="https://instagram.com/scootercoop_" target="_blank" class="insta-post-memphis">
          <img src="/paisaje.jpg" alt="Instagram post" />
          <div class="insta-overlay-memphis">
            <i class="bx bxl-instagram"></i>
          </div>
        </a>
        <a href="https://instagram.com/scootercoop_" target="_blank" class="insta-post-memphis">
          <img src="/atardecer.jpg" alt="Instagram post" />
          <div class="insta-overlay-memphis">
            <i class="bx bxl-instagram"></i>
          </div>
        </a>
      </div>

      <a href="https://instagram.com/scootercoop_" target="_blank" class="insta-btn-memphis">
        <i class="bx bxl-instagram"></i>
        Ver más en Instagram
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section-memphis py-16 relative overflow-hidden bg-cream">
    <div class="cta-deco-memphis cta-deco-1"></div>
    <div class="cta-deco-memphis cta-deco-2"></div>

    <div class="container mx-auto text-center relative z-10 px-4">
      <h2 class="section-title">¿YA VIVISTE LA EXPERIENCIA?</h2>
      <p class="section-subtitle mt-4">Comparte tu experiencia con el hashtag #ScooterCoopBarranquilla</p>
      <div class="mt-8">
        <MemphisButton href="/contacto" variant="primary" size="lg">RESERVAR AHORA</MemphisButton>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll('.filter-btn-memphis').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn-memphis').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = (btn as HTMLElement).dataset.filter;
        document.querySelectorAll('.gallery-item-memphis').forEach(item => {
          const htmlItem = item as HTMLElement;
          if (filter === 'todos' || htmlItem.dataset.category === filter) {
            htmlItem.style.display = 'block';
          } else {
            htmlItem.style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>

<style is:global>
  .hero-memphis {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: center;
    background-color: var(--color-cream);
    overflow: hidden;
  }

  .hero-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--color-text-dots) 2px, transparent 2px);
    background-size: 20px 20px;
    opacity: 0.3;
  }

  @media (prefers-color-scheme: dark) {
    .hero-memphis {
      background-color: var(--color-cream);
    }

    .hero-pattern {
      --color-text-dots: rgba(245,245,245,0.15);
    }
  }

  :root {
    --color-text-dots: rgba(45,45,45,0.05);
  }

.hero-deco {
  @apply absolute pointer-events-none rounded-full;
}

.hero-deco-1 {
  @apply w-32 h-32 rounded-full bg-pink;
  top: 10%;
  right: 15%;
  opacity: 0.2;
}

.hero-deco-2 {
  @apply w-20 h-20 rounded-full bg-blue;
  bottom: 15%;
  left: 10%;
  opacity: 0.25;
}

.hero-title-memphis {
  @apply font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-text leading-tight mb-4;
}

.hero-desc-memphis {
  @apply font-body text-lg text-gray-600;
}

.filter-btn-memphis {
  @apply px-4 py-2 bg-white border-4 border-solid border-text font-subheading font-bold text-sm text-text;
  transition: all 0.2s ease;
}

.filter-btn-memphis:hover,
.filter-btn-memphis.active {
  @apply bg-pink border-pink text-white;
  transform: scale(1.05);
}

.gallery-grid-memphis {
  @apply grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6;
}

.gallery-item-memphis {
    @apply relative overflow-hidden border-4 border-solid border-text bg-white;
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.1);
    animation: drop-in 0.4s ease-out backwards;
    transition: all 0.3s ease;
  }

  .gallery-item-memphis:hover {
    transform: translateY(-4px) rotate(1deg);
    box-shadow: 10px 10px 0 rgba(0, 0, 0, 0.12);
  }

  @media (prefers-color-scheme: dark) {
    .gallery-item-memphis {
      box-shadow: 6px 6px 0 rgba(255, 255, 255, 0.1);
    }

    .gallery-item-memphis:hover {
      box-shadow: 10px 10px 0 rgba(255, 255, 255, 0.12);
    }
  }

.gallery-image-container-memphis {
  @apply relative h-64;
}

.gallery-image-memphis {
  @apply w-full h-full object-cover transition-transform duration-500;
}

.gallery-item-memphis:hover .gallery-image-memphis {
  transform: scale(1.1);
}

.gallery-overlay-memphis {
  @apply absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent flex flex-col justify-between p-4 opacity-0 transition-opacity duration-300;
}

.gallery-item-memphis:hover .gallery-overlay-memphis {
  @apply opacity-100;
}

.gallery-tag-memphis {
  @apply self-start px-3 py-1 bg-pink text-white font-subheading font-bold text-xs rounded-full;
}

.gallery-info-memphis h3 {
  @apply font-heading text-lg text-white mb-1;
}

.gallery-info-memphis p {
  @apply font-body text-sm text-gray-300;
}

.instagram-section-memphis {
  @apply relative bg-dark overflow-hidden;
}

.instagram-deco {
  @apply absolute inset-0 pointer-events-none;
  background: repeating-linear-gradient(
    -45deg,
    rgba(255, 107, 157, 0.05),
    rgba(255, 107, 157, 0.05) 10px,
    transparent 10px,
    transparent 20px
  );
}

.instagram-title-memphis {
  @apply font-heading text-2xl text-white mb-2 flex items-center justify-center gap-3;
}

.instagram-title-memphis i {
  @apply text-pink text-3xl;
}

.instagram-desc-memphis {
  @apply font-body text-gray-400 mb-8;
}

.insta-grid-memphis {
  @apply grid grid-cols-3 md:grid-cols-6 gap-3 max-w-4xl mx-auto mb-8;
}

.insta-post-memphis {
  @apply relative aspect-square overflow-hidden;
  border: 4px solid rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
}

.insta-post-memphis:hover {
  @apply border-pink;
  transform: scale(1.05);
}

.insta-post-memphis img {
  @apply w-full h-full object-cover transition-all duration-300;
  filter: grayscale(50%);
}

.insta-post-memphis:hover img {
  filter: grayscale(0%);
}

.insta-overlay-memphis {
  @apply absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-300;
  background-color: rgba(255, 107, 157, 0.8);
}

.insta-post-memphis:hover .insta-overlay-memphis {
  @apply opacity-100;
}

.insta-overlay-memphis i {
  @apply text-white text-3xl;
}

.insta-btn-memphis {
  @apply inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-purple to-pink text-white font-subheading font-bold text-sm rounded-full;
  transition: all 0.3s ease;
}

.insta-btn-memphis:hover {
  @apply shadow-lg transform scale-105;
  box-shadow: 0 10px 30px rgba(155, 89, 246, 0.3);
}

.cta-section-memphis {
  @apply relative;
}

.cta-deco-memphis {
  @apply absolute pointer-events-none rounded-full;
}

.cta-deco-1 {
  @apply w-40 h-40 rounded-full bg-yellow;
  top: -20px;
  left: 10%;
  opacity: 0.15;
}

.cta-deco-2 {
  @apply w-24 h-24 rounded-full bg-pink;
  bottom: 20%;
  right: 15%;
  opacity: 0.1;
}

@keyframes drop-in {
  0% { transform: translateY(-20px); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}
</style>