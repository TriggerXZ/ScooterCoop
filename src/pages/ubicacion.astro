---
import Layout from "../layouts/Layout.astro";
import MemphisCard from "../components/MemphisCard.astro";
import MemphisButton from "../components/MemphisButton.astro";
---

<Layout title="Ubicación" description="Encuentra nuestra ubicación en el Malecón de Barranquilla para alquilar scooters eléctricos">
  <!-- Hero Section -->
  <section class="hero-memphis">
    <div class="hero-pattern"></div>
    <div class="hero-deco hero-deco-1"></div>
    <div class="hero-deco hero-deco-2"></div>

    <div class="container mx-auto px-4 py-32 relative z-10 text-center">
      <h1 class="hero-title-memphis">
        UBICACIÓN<br/>
        <span class="text-blue">SCOOTERCOOP</span>
      </h1>
      <p class="hero-desc-memphis">Encuéntranos fácilmente en el corazón del Gran Malecón del Río</p>
    </div>
  </section>

  <!-- Info Section -->
  <section class="py-16 bg-cream">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Location Info -->
        <MemphisCard variant="blue" class="info-card-memphis" data-aos="fade-right" data-aos-delay="200">
          <h2 class="info-title-memphis">CÓMO ENCONTRARNOS</h2>

          <div class="info-items-memphis">
            <div class="info-item-memphis">
              <div class="info-icon-memphis info-icon-blue">
                <i class="bx bx-map"></i>
              </div>
              <div class="info-content-memphis">
                <h3>Dirección</h3>
                <p>Malecón del Río, Barranquilla</p>
                <span class="info-tag-memphis info-tag-blue">Sector Puerta de Oro</span>
              </div>
            </div>

            <div class="info-item-memphis">
              <div class="info-icon-memphis info-icon-lime">
                <i class="bx bx-time"></i>
              </div>
              <div class="info-content-memphis">
                <h3>Horario de Atención</h3>
                <p>Lun - Vie: 3:00 PM - 10:00 PM</p>
                <p>Sáb - Dom: 2:00 PM - 11:00 PM</p>
              </div>
            </div>

            <div class="info-item-memphis">
              <div class="info-icon-memphis info-icon-yellow">
                <i class="bx bx-phone"></i>
              </div>
              <div class="info-content-memphis">
                <h3>Contacto</h3>
                <p>+57 300 123 4567</p>
                <span class="info-tag-memphis info-tag-lime">WhatsApp disponible</span>
              </div>
            </div>
          </div>
        </MemphisCard>

        <!-- How to Get There -->
        <MemphisCard variant="yellow" class="transport-card-memphis" data-aos="fade-left" data-aos-delay="300">
          <h2 class="info-title-memphis">CÓMO LLEGAR</h2>

          <div class="transport-options-memphis">
            <div class="transport-item-memphis">
              <div class="transport-icon-memphis transport-icon-lime">
                <i class="bx bx-bus"></i>
              </div>
              <div class="transport-content-memphis">
                <h3>Transporte Público</h3>
                <ul>
                  <li>Ruta Transmetro A8-1 Paraíso</li>
                  <li>Bájate en estación cercana al Malecón</li>
                  <li>Camina 5 minutos hacia el río</li>
                </ul>
              </div>
            </div>

            <div class="transport-item-memphis">
              <div class="transport-icon-memphis transport-icon-yellow">
                <i class="bx bx-car"></i>
              </div>
              <div class="transport-content-memphis">
                <h3>Vehículo Particular</h3>
                <ul>
                  <li>Ingresa por la Vía 40</li>
                  <li>Parqueadero en Puerta de Oro</li>
                  <li>Waze/Google Maps: "ScooterCoop"</li>
                </ul>
              </div>
            </div>
          </div>
        </MemphisCard>
      </div>
    </div>
  </section>

  <!-- Nearby Attractions -->
  <section class="py-16 bg-cream">
    <div class="container mx-auto px-4">
      <h2 class="section-title text-center mb-12">ATRACCIONES CERCANAS</h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <MemphisCard variant="blue" class="attraction-card-memphis text-center" data-aos="fade-up" data-aos-delay="100">
          <div class="attraction-icon-memphis attraction-icon-blue">
            <i class="bx bx-water text-3xl"></i>
          </div>
          <h3 class="attraction-title-memphis">Gran Malecón</h3>
          <p class="attraction-desc-memphis">Disfruta del recorrido con vistas impresionantes al río Magdalena y la brisa fresca del Caribe.</p>
        </MemphisCard>

        <MemphisCard variant="coral" class="attraction-card-memphis text-center" data-aos="fade-up" data-aos-delay="200">
          <div class="attraction-icon-memphis attraction-icon-coral">
            <i class="bx bx-restaurant text-3xl"></i>
          </div>
          <h3 class="attraction-title-memphis">Caimán del Río</h3>
          <p class="attraction-desc-memphis">Variedad de restaurantes y cafés con deliciosa comida local e internacional.</p>
        </MemphisCard>

        <MemphisCard variant="yellow" class="attraction-card-memphis text-center" data-aos="fade-up" data-aos-delay="300">
          <div class="attraction-icon-memphis attraction-icon-yellow">
            <i class="bx bx-camera text-3xl"></i>
          </div>
          <h3 class="attraction-title-memphis">Aleta del Tiburón</h3>
          <p class="attraction-desc-memphis">El icónico monumento-homenaje al Junior de Barranquilla, punto perfecto para fotos.</p>
        </MemphisCard>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="py-16 bg-cream">
    <div class="container mx-auto px-4">
      <h2 class="section-title text-center mb-8">ENCUÉNTRANOS AQUÍ</h2>
      <MemphisCard variant="blue" class="map-container-memphis" data-aos="zoom-in">
        <img src="/mapa.jpg" alt="Mapa de ubicación en el Malecón del Río" class="map-image-memphis" />
        <div class="map-marker-memphis">
          <i class="bx bx-map-pin"></i>
          <span>Punto de Encuentro</span>
        </div>
      </MemphisCard>
    </div>
  </section>

  <!-- Points of Interest -->
  <section class="py-16 bg-cream">
    <div class="container mx-auto px-4">
      <h2 class="section-title text-center">PUNTOS DE INTERÉS</h2>
      <p class="section-subtitle text-center mt-4">Explora estos lugares durante tu recorrido</p>

      <div class="poi-grid-memphis mt-12">
        <div class="poi-card-memphis">
          <img src="/monumentotiburon.jpg" alt="Monumento Tiburón" />
          <div class="poi-info-memphis">
            <span class="poi-badge-memphis poi-badge-blue">MONUMENTO</span>
            <h4>Monumento Tiburón</h4>
            <p>Homenaje al Junior de Barranquilla</p>
          </div>
        </div>
        <div class="poi-card-memphis">
          <img src="/atardecer.jpg" alt="Atardecer" />
          <div class="poi-info-memphis">
            <span class="poi-badge-memphis poi-badge-yellow">VISTA</span>
            <h4>Punto Panorámico</h4>
            <p>El mejor atardecer del Caribe</p>
          </div>
        </div>
        <div class="poi-card-memphis">
          <img src="/paisaje.jpg" alt="Malecón" />
          <div class="poi-info-memphis">
            <span class="poi-badge-memphis poi-badge-lime">RÍO</span>
            <h4>Río Magdalena</h4>
            <p>La magia del río más grande de Colombia</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 relative overflow-hidden bg-cream">
    <div class="cta-deco-memphis cta-deco-1"></div>
    <div class="cta-deco-memphis cta-deco-2"></div>

    <div class="container mx-auto text-center relative z-10 px-4">
      <h2 class="section-title">¿LISTO PARA VISITARNOS?</h2>
      <p class="section-subtitle mt-4">Vive la mejor experiencia en scooters eléctricos del Malecón</p>
      <div class="cta-buttons-memphis mt-8">
        <MemphisButton href="/servicios" variant="primary" size="lg">VER SERVICIOS</MemphisButton>
        <MemphisButton href="/contacto" variant="secondary" size="lg">CONTÁCTANOS</MemphisButton>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-memphis {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: center;
    background-color: var(--color-cream);
    overflow: hidden;
  }

  @media (prefers-color-scheme: dark) {
    .hero-memphis {
      background-color: var(--color-cream);
    }
  }

.hero-pattern {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle, #00ADEE 3px, transparent 3px);
  background-size: 24px 24px;
  opacity: 0.3;
}

.hero-deco {
  @apply absolute pointer-events-none rounded-full;
}

.hero-deco-1 {
  @apply w-32 h-32 rounded-full bg-blue;
  top: 10%;
  right: 15%;
  opacity: 0.2;
}

.hero-deco-2 {
  @apply w-20 h-20 rounded-full bg-yellow;
  bottom: 15%;
  left: 10%;
  opacity: 0.25;
}

.hero-title-memphis {
    @apply font-heading text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-4;
    color: var(--color-text);
  }

  .hero-desc-memphis {
    @apply font-body text-lg;
    color: var(--color-gray-600);
  }

  .info-card-memphis,
  .transport-card-memphis {
    @apply p-6;
  }

  .info-title-memphis {
    @apply font-heading text-xl font-bold mb-6;
    color: var(--color-text);
  }

  .info-items-memphis {
    @apply flex flex-col gap-4;
  }

  .info-item-memphis {
    @apply flex gap-4 p-4 bg-cream rounded-lg border-2 border-dashed border-gray-200;
  }

  .info-icon-memphis {
    @apply w-12 h-12 flex items-center justify-center border-4 border-solid rounded-full flex-shrink-0;
  }

  .info-icon-blue {
    @apply border-blue text-blue;
  }

  .info-icon-lime {
    @apply border-lime text-lime;
  }

  .info-icon-yellow {
    @apply border-yellow text-yellow;
  }

  .info-content-memphis h3 {
    @apply font-subheading font-bold text-sm mb-1;
    color: var(--color-text);
  }

.info-content-memphis p {
    @apply font-body text-sm;
    color: var(--color-gray-500);
  }

.info-tag-memphis {
  @apply inline-block mt-2 px-2 py-1 font-subheading font-bold text-xs rounded-full;
}

.info-tag-blue {
  @apply bg-blue text-white;
}

.info-tag-lime {
  @apply bg-lime text-dark;
}

.transport-options-memphis {
  @apply flex flex-col gap-4;
}

.transport-item-memphis {
  @apply flex gap-4 p-4 bg-cream rounded-lg border-2 border-dashed border-gray-200;
}

.transport-icon-memphis {
  @apply w-10 h-10 flex items-center justify-center border-4 border-solid rounded-full flex-shrink-0;
}

.transport-icon-lime {
  @apply border-lime text-lime;
}

.transport-icon-yellow {
  @apply border-yellow text-yellow;
}

.transport-content-memphis h3 {
  @apply font-subheading font-bold text-sm text-text mb-2;
}

.transport-content-memphis ul {
  @apply list-none p-0 m-0 space-y-1;
}

.transport-content-memphis li {
  @apply relative pl-4 font-body text-sm text-gray-600;
}

.transport-content-memphis li::before {
  content: '';
  @apply absolute left-0 top-2 w-2 h-2 rounded-full bg-lime;
}

.attraction-card-memphis {
  @apply p-6;
}

.attraction-icon-memphis {
  @apply w-16 h-16 mx-auto mb-4 flex items-center justify-center border-4 border-solid rounded-full;
}

.attraction-icon-blue {
  @apply border-blue text-blue;
}

.attraction-icon-coral {
  @apply border-coral text-coral;
}

.attraction-icon-yellow {
  @apply border-yellow text-yellow;
}

.attraction-title-memphis {
  @apply font-heading text-lg font-bold text-text mb-2;
}

.attraction-desc-memphis {
  @apply font-body text-sm text-gray-600;
}

.map-container-memphis {
  @apply relative overflow-hidden max-w-4xl mx-auto;
}

.map-image-memphis {
  @apply w-full h-auto max-h-96 object-cover;
}

.map-marker-memphis {
    @apply absolute bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-2 px-4 py-2 bg-white border-4 border-solid border-yellow font-subheading font-bold text-sm text-text rounded-full;
    box-shadow: 4px 4px 0 var(--shadow-color);
  }

  @media (prefers-color-scheme: dark) {
    .map-marker-memphis {
      box-shadow: 4px 4px 0 rgba(255, 255, 255, 0.1);
    }
  }

.map-marker-memphis i {
  @apply text-yellow text-xl animate-bounce;
}

.poi-grid-memphis {
  @apply grid grid-cols-1 md:grid-cols-3 gap-6;
}

.poi-card-memphis {
    @apply relative overflow-hidden border-4 border-solid border-text bg-white;
    box-shadow: 6px 6px 0 var(--shadow-color);
    transition: all 0.3s ease;
  }

  @media (prefers-color-scheme: dark) {
    .poi-card-memphis {
      box-shadow: 6px 6px 0 rgba(255, 255, 255, 0.1);
    }

    .poi-card-memphis:hover {
      box-shadow: 10px 10px 0 rgba(255, 255, 255, 0.12);
    }
  }

.poi-card-memphis:hover {
  transform: translateY(-4px) rotate(0.5deg);
  box-shadow: 10px 10px 0 rgba(0, 0, 0, 0.12);
}

.poi-card-memphis img {
  @apply w-full h-48 object-cover;
}

.poi-info-memphis {
  @apply p-4;
}

.poi-badge-memphis {
  @apply inline-block px-2 py-1 font-subheading font-bold text-xs rounded-full;
}

.poi-badge-blue {
  @apply bg-blue text-white;
}

.poi-badge-yellow {
  @apply bg-yellow text-text;
}

.poi-badge-lime {
  @apply bg-lime text-dark;
}

.poi-info-memphis h4 {
  @apply font-heading text-base text-text my-2;
}

.poi-info-memphis p {
  @apply font-body text-sm text-gray-500;
}

.cta-buttons-memphis {
  @apply flex flex-col sm:flex-row gap-4 justify-center;
}

.cta-deco-memphis {
  @apply absolute pointer-events-none rounded-full;
}

.cta-deco-1 {
  @apply w-40 h-40 rounded-full bg-yellow;
  top: -20px;
  left: 10%;
  opacity: 0.15;
}

.cta-deco-2 {
  @apply w-24 h-24 rounded-full bg-blue;
  bottom: 20%;
  right: 15%;
  opacity: 0.1;
}
</style>