---
import Layout from "../../layouts/Layout.astro";
import Animation from "../../components/Animation.astro";

const posts = [
  {
    slug: "que-ver-en-el-malecon-barranquilla",
    title: "Qué ver en el Malecón de Barranquilla en scooter",
    excerpt: "Descubre los puntos turísticos más icónicos del Malecón del Río navigando en scooter eléctrico. Desde el monumento a losdd hasta el atardecer perfecto.",
    image: "/paisaje.jpg",
    date: "2026-03-10",
    category: "Rutas Turísticas",
    readTime: "5 min"
  },
  {
    slug: "mejores-horarios-para-visitar-malecon",
    title: "Los mejores horarios para visitar el Malecón",
    excerpt: "Te contamos cuál es el mejor momento del día para recorrer el Malecón en scooter y aprovechar al máximo tu experiencia.",
    image: "/atardecer.jpg",
    date: "2026-03-05",
    category: "Consejos",
    readTime: "3 min"
  },
  {
    slug: "beneficios-scooter-electrico",
    title: "Por qué elegir un scooter eléctrico para turistear",
    excerpt: "Explora los beneficios ambientales, económicos y prácticos de usar scooters eléctricos como medio de transporte turístico.",
    image: "/equipo.jpg",
    date: "2026-02-28",
    category: "Movilidad",
    readTime: "4 min"
  },
  {
    slug: "historia-malecon-rio-barranquilla",
    title: "Historia del Malecón del Río Barranquilla",
    excerpt: "Un recorrido por la historia y transformación del Malecón del Río, el icono de la movilidad y entretenimiento barranquillero.",
    image: "/paisaje.jpg",
    date: "2026-02-20",
    category: "Historia",
    readTime: "6 min"
  }
];

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Blog de ScooterCoop",
  "description": "Consejos, rutas turísticas y guía completa para explorar el Malecón de Barranquilla en scooter eléctrico.",
  "url": "https://scootercoop.com/blog",
  "publisher": {
    "@type": "Organization",
    "name": "ScooterCoop",
    "logo": {
      "@type": "ImageObject",
      "url": "https://scootercoop.com/logo.png"
    }
  }
};
---

<Layout
  title="Blog"
  description="Blog de ScooterCoop - Consejos, rutas turísticas y guías para explorar el Malecón de Barranquilla en scooter eléctrico."
  schemaType="website"
>
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

  <!-- Hero Section -->
  <section class="relative overflow-hidden py-24 bg-dark">
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-secondary/10 via-dark to-dark opacity-40"
    >
    </div>
    <div
      class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-5 bg-[length:40px_40px]"
    >
    </div>

    <div class="container mx-auto px-4 relative z-10 text-center">
      <Animation animation="fade-down">
        <h1 class="text-4xl md:text-6xl font-bold mb-6 text-white">
          Blog <span class="text-transparent bg-clip-text bg-gradient-to-r from-secondary to-accent">ScooterCoop</span>
        </h1>
      </Animation>
      <Animation animation="fade-up" delay={200}>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          Consejos, rutas y todo lo que necesitas saber para explorar el Malecón de Barranquilla.
        </p>
      </Animation>
    </div>
  </section>

  <!-- Blog Posts -->
  <section class="py-16 bg-dark relative">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post, index) => (
          <Animation animation="fade-up" delay={index * 100}>
            <article class="bg-white/5 border border-white/10 rounded-3xl overflow-hidden hover:border-secondary/50 transition-all duration-300 group">
              <a href={`/blog/${post.slug}`} class="block">
                <div class="relative h-48 overflow-hidden">
                  <img
                    src={post.image}
                    alt={post.title}
                    class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-dark to-transparent"></div>
                  <span class="absolute top-4 left-4 px-3 py-1 bg-primary/90 text-dark text-xs font-bold rounded-full">
                    {post.category}
                  </span>
                </div>
                <div class="p-6">
                  <div class="flex items-center gap-4 text-sm text-gray-400 mb-3">
                    <span class="flex items-center gap-1">
                      <i class="bx bx-calendar"></i>
                      {new Date(post.date).toLocaleDateString('es-CO', { day: 'numeric', month: 'short', year: 'numeric' })}
                    </span>
                    <span class="flex items-center gap-1">
                      <i class="bx bx-time"></i>
                      {post.readTime}
                    </span>
                  </div>
                  <h2 class="text-xl font-bold text-white mb-3 group-hover:text-secondary transition-colors line-clamp-2">
                    {post.title}
                  </h2>
                  <p class="text-gray-400 text-sm line-clamp-3">
                    {post.excerpt}
                  </p>
                </div>
              </a>
            </article>
          </Animation>
        ))}
      </div>

      <!-- CTA -->
      <Animation animation="fade-up" delay={500}>
        <div class="mt-16 text-center">
          <a
            href="/contacto"
            class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-secondary to-accent text-white font-bold rounded-full hover:shadow-[0_0_30px_rgba(112,0,255,0.4)] transition-all"
          >
            <i class="bx bx-calendar-plus"></i>
            Reserva tu Tour
          </a>
        </div>
      </Animation>
    </div>
  </section>
</Layout>
