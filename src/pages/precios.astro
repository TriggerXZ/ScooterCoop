---
import Layout from "../layouts/Layout.astro";
import MemphisCard from "../components/MemphisCard.astro";
import MemphisButton from "../components/MemphisButton.astro";
---

<Layout title="Precios" description="Tarifas de alquiler de scooters eléctricos en el Malecón de Barranquilla">
  <!-- Hero Section -->
  <section class="hero-memphis">
    <div class="hero-pattern"></div>
    <div class="hero-deco hero-deco-1"></div>
    <div class="hero-deco hero-deco-2"></div>

    <div class="container mx-auto px-4 py-32 relative z-10">
      <h1 class="hero-title-memphis text-center">
        NUESTROS<br/>
        <span class="text-yellow">PRECIOS</span>
      </h1>
      <p class="hero-desc-memphis text-center">Tarifas transparentes para tu aventura por el Malecón</p>
    </div>
  </section>

  <!-- Pricing Section -->
  <section class="py-24 bg-cream">
    <div class="container mx-auto px-4">
      <!-- Individual Plans -->
      <div class="text-center mb-16">
        <h2 class="section-title">PLANES INDIVIDUALES</h2>
        <p class="section-subtitle">Elige la duración perfecta para tu recorrido</p>
      </div>

      <div class="pricing-grid-memphis">
        <!-- Plan Básico -->
        <MemphisCard variant="blue" class="pricing-card-memphis" data-aos="fade-up" data-aos-delay="100">
          <div class="pricing-header-memphis">
            <h3 class="pricing-title-memphis">BÁSICO</h3>
            <span class="pricing-duration-memphis">30 minutos</span>
          </div>
          <div class="pricing-price-memphis">
            <span class="price-currency-memphis">$</span>
            <span class="price-amount-memphis text-blue">25.000</span>
            <span class="price-currency-memphis">COP</span>
          </div>
          <ul class="pricing-features-memphis pricing-features-blue">
            <li><i class="bx bx-helmet"></i> Casco de seguridad</li>
            <li><i class="bx bx-user-voice"></i> Inducción técnica</li>
            <li><i class="bx bx-map"></i> Guía de puntos turísticos</li>
            <li><i class="bx bx-user-follow"></i> Acompañamiento</li>
          </ul>
          <MemphisButton href="/contacto?servicio=30min" variant="outline" class="w-full">RESERVAR</MemphisButton>
        </MemphisCard>

        <!-- Plan Estándar -->
        <MemphisCard variant="yellow" class="pricing-card-memphis featured" data-aos="fade-up" data-aos-delay="200">
          <div class="popular-badge">MÁS POPULAR</div>
          <div class="pricing-header-memphis">
            <h3 class="pricing-title-memphis">ESTÁNDAR</h3>
            <span class="pricing-duration-memphis">40 minutos</span>
          </div>
          <div class="pricing-price-memphis">
            <span class="price-currency-memphis">$</span>
            <span class="price-amount-memphis text-yellow">30.000</span>
            <span class="price-currency-memphis">COP</span>
          </div>
          <ul class="pricing-features-memphis pricing-features-yellow">
            <li><i class="bx bx-helmet"></i> Casco de seguridad</li>
            <li><i class="bx bx-user-voice"></i> Inducción técnica</li>
            <li><i class="bx bx-map"></i> Guía de puntos turísticos</li>
            <li><i class="bx bx-user-follow"></i> Acompañamiento</li>
          </ul>
          <MemphisButton href="/contacto?servicio=40min" variant="primary" class="w-full">RESERVAR</MemphisButton>
        </MemphisCard>

        <!-- Plan Premium -->
        <MemphisCard variant="pink" class="pricing-card-memphis" data-aos="fade-up" data-aos-delay="300">
          <div class="pricing-header-memphis">
            <h3 class="pricing-title-memphis">PREMIUM</h3>
            <span class="pricing-duration-memphis">60 minutos</span>
          </div>
          <div class="pricing-price-memphis">
            <span class="price-currency-memphis">$</span>
            <span class="price-amount-memphis text-pink">40.000</span>
            <span class="price-currency-memphis">COP</span>
          </div>
          <ul class="pricing-features-memphis pricing-features-pink">
            <li><i class="bx bx-helmet"></i> Casco de seguridad</li>
            <li><i class="bx bx-user-voice"></i> Inducción técnica</li>
            <li><i class="bx bx-map"></i> Guía de puntos turísticos</li>
            <li><i class="bx bx-user-follow"></i> Acompañamiento</li>
          </ul>
          <MemphisButton href="/contacto?servicio=60min" variant="outline" class="w-full">RESERVAR</MemphisButton>
        </MemphisCard>
      </div>

      <!-- Group Plans -->
      <div class="mt-24">
        <div class="text-center mb-12">
          <h2 class="section-title">PLANES GRUPALES</h2>
          <p class="section-subtitle">Experiencias perfectas para compartir</p>
        </div>

        <div class="group-grid-memphis">
          <!-- Tours Grupales -->
          <MemphisCard variant="yellow" class="group-card-memphis" data-aos="fade-up" data-aos-delay="100">
            <div class="group-icon-memphis group-icon-yellow">
              <i class="bx bx-group text-2xl"></i>
            </div>
            <h3 class="group-title-memphis">TOURS GUIADOS</h3>
            <p class="group-subtitle-memphis">Amigos y Familia</p>
            <div class="group-price-memphis">
              <span class="price-amount-memphis text-yellow">$40.000</span>
              <span class="price-unit-memphis">/ persona</span>
            </div>
            <p class="group-min-memphis">Mínimo 5 personas</p>
            <ul class="group-features-memphis group-features-yellow">
              <li><i class="bx bx-time-five"></i> 1h 30min de recorrido</li>
              <li><i class="bx bx-user-voice"></i> Guía privado exclusivo</li>
              <li><i class="bx bx-camera"></i> Fotos grupales incluidas</li>
              <li><i class="bx bx-map-alt"></i> Ruta personalizada</li>
            </ul>
            <MemphisButton href="/contacto?servicio=tour-grupal" variant="primary" class="w-full">SOLICITAR INFO</MemphisButton>
          </MemphisCard>

          <!-- Corporativo -->
          <MemphisCard variant="coral" class="group-card-memphis" data-aos="fade-up" data-aos-delay="200">
            <div class="group-icon-memphis group-icon-coral">
              <i class="bx bx-briefcase-alt-2 text-2xl"></i>
            </div>
            <h3 class="group-title-memphis">CORPORATIVO</h3>
            <p class="group-subtitle-memphis">Empresas y Eventos</p>
            <div class="group-price-memphis">
              <span class="price-amount-memphis text-coral">A Medida</span>
            </div>
            <p class="group-min-memphis">Cotización personalizada</p>
            <ul class="group-features-memphis group-features-coral">
              <li><i class="bx bx-group"></i> Team Building</li>
              <li><i class="bx bx-flag"></i> Branding con tu marca</li>
              <li><i class="bx bx-video"></i> Cobertura drone y video</li>
              <li><i class="bx bx-coffee"></i> Catering opcional</li>
            </ul>
            <MemphisButton href="/contacto?servicio=corporativo" variant="accent" class="w-full">COTIZAR</MemphisButton>
          </MemphisCard>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 relative overflow-hidden bg-cream">
    <div class="cta-deco-memphis cta-deco-1"></div>
    <div class="cta-deco-memphis cta-deco-2"></div>
    <div class="cta-deco-memphis cta-deco-3"></div>

    <div class="container mx-auto px-4 text-center relative z-10">
      <h2 class="section-title">¿QUIÉN ERES?</h2>
      <p class="section-subtitle mt-4">Tenemos el plan perfecto para ti</p>
      <div class="mt-10">
        <MemphisButton href="/contacto" variant="primary" size="lg">RESERVAR AHORA</MemphisButton>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-memphis {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: center;
    background-color: var(--color-cream);
    overflow: hidden;
  }

  @media (prefers-color-scheme: dark) {
    .hero-memphis {
      background-color: var(--color-cream);
    }
  }

.hero-pattern {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle, #FFE135 3px, transparent 3px);
  background-size: 24px 24px;
  opacity: 0.3;
}

.hero-deco {
  @apply absolute pointer-events-none rounded-full;
}

.hero-deco-1 {
  @apply w-32 h-32 rounded-full bg-yellow;
  top: 10%;
  right: 15%;
  opacity: 0.2;
}

.hero-deco-2 {
  @apply w-20 h-20 rounded-full bg-pink;
  bottom: 15%;
  left: 10%;
  opacity: 0.25;
}

.hero-title-memphis {
    @apply font-heading text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-4;
    color: var(--color-text);
  }

  .hero-desc-memphis {
    @apply font-body text-lg;
    color: var(--color-gray-600);
  }

  .pricing-grid-memphis {
    @apply grid grid-cols-1 md:grid-cols-3 gap-8 items-center;
  }

  .pricing-card-memphis {
    @apply p-6 text-center;
  }

  .pricing-card-memphis.featured {
    @apply md:scale-105;
  }

  .pricing-header-memphis {
    @apply mb-4;
  }

  .pricing-title-memphis {
    @apply font-heading text-2xl font-bold mb-1;
    color: var(--color-text);
  }

  .pricing-duration-memphis {
    @apply font-body text-sm;
    color: var(--color-gray-500);
  }

  .pricing-price-memphis {
    @apply mb-4 pb-4 border-b-2 border-dashed border-gray-200;
  }

  @media (prefers-color-scheme: dark) {
    .pricing-price-memphis {
      @apply border-gray-600;
    }
  }

.price-currency-memphis {
    @apply font-heading text-base;
    vertical-align: top;
    color: var(--color-text);
  }

  .price-amount-memphis {
    @apply font-heading text-4xl font-bold;
  }

  .pricing-features-memphis {
    @apply list-none p-0 m-0 mb-6 text-left space-y-2;
  }

  .pricing-features-memphis li {
    @apply flex items-center gap-3 font-body text-sm;
    color: var(--color-gray-600);
  }

  .pricing-features-memphis li i {
  @apply text-lg;
}

.pricing-features-blue li i { color: #00ADEE; }
.pricing-features-yellow li i { color: #FFE135; }
.pricing-features-pink li i { color: #FF6B9D; }

.group-grid-memphis {
  @apply grid grid-cols-1 md:grid-cols-2 gap-8;
}

.group-card-memphis {
  @apply p-6;
}

.group-icon-memphis {
  @apply w-14 h-14 flex items-center justify-center border-4 border-solid rounded-full mb-4;
}

.group-icon-yellow {
  @apply border-yellow text-yellow;
}

.group-icon-coral {
  @apply border-coral text-coral;
}

.group-title-memphis {
    @apply font-heading text-2xl font-bold mb-1;
    color: var(--color-text);
  }

  .group-subtitle-memphis {
    @apply font-body text-sm mb-2;
    color: var(--color-gray-500);
  }

  .group-price-memphis {
    @apply mb-2;
  }

  .price-unit-memphis {
    @apply font-body text-sm;
    color: var(--color-gray-500);
  }

  .group-min-memphis {
    @apply font-subheading font-bold text-xs mb-4;
    color: var(--color-yellow);
  }

  .group-features-memphis {
  @apply list-none p-0 m-0 mb-6 space-y-2;
}

.group-features-memphis li {
  @apply flex items-center gap-3 font-body text-sm text-gray-600;
}

.group-features-memphis li i {
  @apply text-lg;
}

.group-features-yellow li i { color: #FFE135; }
.group-features-coral li i { color: #FF6B35; }

.cta-deco-memphis {
  @apply absolute pointer-events-none rounded-full;
}

.cta-deco-1 {
  @apply w-40 h-40 rounded-full bg-yellow;
  top: -20px;
  left: 10%;
  opacity: 0.15;
}

.cta-deco-2 {
  @apply w-24 h-24 rounded-full bg-pink;
  bottom: 20%;
  right: 15%;
  opacity: 0.1;
}

.cta-deco-3 {
  @apply w-16 h-16 rounded-full bg-blue;
  top: 40%;
  right: 5%;
  opacity: 0.12;
}

.popular-badge {
    @apply absolute -top-3 left-1/2 -translate-x-1/2 bg-yellow font-subheading font-bold text-xs px-4 py-1;
    color: var(--color-text);
    box-shadow: 3px 3px 0 #8B4513;
  }
</style>