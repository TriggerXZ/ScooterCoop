---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import MemphisCard from "../components/MemphisCard.astro";
import MemphisButton from "../components/MemphisButton.astro";
import ReviewsSection from "../components/ReviewsSection.astro";
---

<Layout title="Inicio" description="Alquiler de scooters eléctricos en el Malecón de Barranquilla - ScooterCoop">
  <!-- Hero Section -->
  <HeroSection />

  <!-- Features Section -->
  <section class="py-24 bg-cream relative overflow-hidden">
    <!-- Decorative elements -->
    <div class="section-deco section-deco-1"></div>
    <div class="section-deco section-deco-2"></div>

    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="section-title" data-aos="fade-up">¿POR QUÉ ELEGIRNOS?</h2>
        <p class="section-subtitle mt-4" data-aos="fade-up" data-aos-delay="100">La mejor experiencia del Malecón en scooter eléctrico</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <MemphisCard variant="blue" class="feature-card-memphis" data-aos="fade-up" data-aos-delay="100">
          <div class="icon-box-memphis icon-box-blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <h3 class="feature-title-memphis">VELOCIDAD CONTROLADA</h3>
          <p class="feature-desc-memphis">Hasta 25 km/h de adrenalina segura por el Malecón. Ideales para familias y principiantes.</p>
          <div class="feature-stat-memphis">
            <span class="text-blue text-3xl font-bold">25</span>
            <span class="text-gray-500 ml-2">km/h</span>
          </div>
        </MemphisCard>

        <MemphisCard variant="yellow" class="feature-card-memphis" data-aos="fade-up" data-aos-delay="200">
          <div class="icon-box-memphis icon-box-yellow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <rect x="2" y="7" width="18" height="10" rx="2"/>
              <path d="M22 11v2"/>
            </svg>
          </div>
          <h3 class="feature-title-memphis">AUTONOMÍA TOTAL</h3>
          <p class="feature-desc-memphis">Baterías de larga duración para toda tu aventura sin preocuparte por la carga.</p>
          <div class="feature-stat-memphis">
            <span class="text-yellow text-3xl font-bold">40</span>
            <span class="text-gray-500 ml-2">km</span>
          </div>
        </MemphisCard>

        <MemphisCard variant="pink" class="feature-card-memphis" data-aos="fade-up" data-aos-delay="300">
          <div class="icon-box-memphis icon-box-pink">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="feature-title-memphis">SEGURIDAD ACTIVA</h3>
          <p class="feature-desc-memphis">Casco incluido y asesoría gratuita antes de cada recorrido. Seguro disponible.</p>
          <div class="feature-stat-memphis">
            <span class="text-pink text-3xl font-bold">100</span>
            <span class="text-gray-500 ml-2">%</span>
          </div>
        </MemphisCard>
      </div>
    </div>
  </section>

  <!-- Pricing Preview -->
  <section class="py-24 bg-cream">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="section-title" data-aos="fade-up">PLANES Y TARIFAS</h2>
        <p class="section-subtitle mt-4" data-aos="fade-up" data-aos-delay="100">Elige el plan perfecto para tu experiencia</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <MemphisCard variant="blue" class="price-card-memphis" data-aos="fade-up" data-aos-delay="100">
          <div class="price-header-memphis">
            <h3 class="text-xl font-bold text-text">30 MIN</h3>
            <span class="price-badge price-badge-blue">BÁSICO</span>
          </div>
          <div class="price-amount-memphis">
            <span class="text-blue text-4xl font-bold">$25.000</span>
            <span class="text-gray-500 text-sm ml-2">COP</span>
          </div>
          <ul class="price-features-memphis">
            <li><i class="bx bx-check text-blue"></i> Casco incluido</li>
            <li><i class="bx bx-check text-blue"></i> Asesoría inicial</li>
            <li><i class="bx bx-check text-blue"></i> Guía turístico digital</li>
            <li><i class="bx bx-check text-blue"></i> Mapa de rutas</li>
          </ul>
          <MemphisButton href="/contacto" variant="outline" class="w-full">RESERVAR</MemphisButton>
        </MemphisCard>

        <MemphisCard variant="yellow" class="price-card-memphis featured" data-aos="fade-up" data-aos-delay="200">
          <div class="popular-badge">MÁS POPULAR</div>
          <div class="price-header-memphis">
            <h3 class="text-xl font-bold text-text">40 MIN</h3>
            <span class="price-badge price-badge-yellow">ESTÁNDAR</span>
          </div>
          <div class="price-amount-memphis">
            <span class="text-yellow text-4xl font-bold">$30.000</span>
            <span class="text-gray-500 text-sm ml-2">COP</span>
          </div>
          <ul class="price-features-memphis">
            <li><i class="bx bx-check text-yellow"></i> Casco incluido</li>
            <li><i class="bx bx-check text-yellow"></i> Asesoría inicial</li>
            <li><i class="bx bx-check text-yellow"></i> Guía turístico digital</li>
            <li><i class="bx bx-check text-yellow"></i> Acompañamiento</li>
            <li><i class="bx bx-check text-yellow"></i> Fotos del recorrido</li>
          </ul>
          <MemphisButton href="/contacto" variant="primary" class="w-full">RESERVAR</MemphisButton>
        </MemphisCard>

        <MemphisCard variant="pink" class="price-card-memphis" data-aos="fade-up" data-aos-delay="300">
          <div class="price-header-memphis">
            <h3 class="text-xl font-bold text-text">1 HORA</h3>
            <span class="price-badge price-badge-pink">PREMIUM</span>
          </div>
          <div class="price-amount-memphis">
            <span class="text-pink text-4xl font-bold">$40.000</span>
            <span class="text-gray-500 text-sm ml-2">COP</span>
          </div>
          <ul class="price-features-memphis">
            <li><i class="bx bx-check text-pink"></i> Casco incluido</li>
            <li><i class="bx bx-check text-pink"></i> Asesoría inicial</li>
            <li><i class="bx bx-check text-pink"></i> Guía turístico digital</li>
            <li><i class="bx bx-check text-pink"></i> Acompañamiento</li>
            <li><i class="bx bx-check text-pink"></i> Fotos y video del tour</li>
            <li><i class="bx bx-check text-pink"></i> Descuento siguiente visita</li>
          </ul>
          <MemphisButton href="/contacto" variant="outline" class="w-full">RESERVAR</MemphisButton>
        </MemphisCard>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <ReviewsSection />

  <!-- CTA Section -->
  <section class="py-24 relative overflow-hidden bg-cream">
    <div class="cta-deco cta-deco-1"></div>
    <div class="cta-deco cta-deco-2"></div>
    <div class="cta-deco cta-deco-3"></div>

    <div class="container mx-auto px-4 text-center relative z-10">
      <h2 class="section-title text-4xl md:text-5xl" data-aos="fade-up">¿LISTO PARA LA AVENTURA?</h2>
      <p class="section-subtitle mt-4" data-aos="fade-up" data-aos-delay="100">Reserva ahora y vive la experiencia única del Malecón</p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center" data-aos="fade-up" data-aos-delay="200">
        <MemphisButton href="/contacto" variant="primary" size="lg">RESERVAR AHORA</MemphisButton>
        <MemphisButton href="/experiencias" variant="secondary" size="lg">VER EXPERIENCIAS</MemphisButton>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
.section-deco {
  @apply absolute pointer-events-none rounded-full;
}

.section-deco-1 {
  @apply w-32 h-32 rounded-full bg-yellow;
  top: 2rem;
  left: 5%;
  opacity: 0.15;
}

.section-deco-2 {
  @apply w-20 h-20 rounded-full bg-pink;
  bottom: 3rem;
  right: 8%;
  opacity: 0.1;
}

.feature-card-memphis {
  @apply text-center;
}

.icon-box-memphis {
  @apply w-16 h-16 mx-auto mb-4 flex items-center justify-center border-4 border-solid rounded-full;
}

.icon-box-blue {
  @apply border-blue text-blue;
}

.icon-box-yellow {
  @apply border-yellow text-yellow;
}

.icon-box-pink {
  @apply border-pink text-pink;
}

.icon-box-memphis svg {
  @apply w-8 h-8;
}

.feature-title-memphis {
    @apply font-heading text-lg font-bold mb-2;
    color: var(--color-text);
  }

  .feature-desc-memphis {
    @apply font-body mb-4;
    color: var(--color-gray-600);
  }

.feature-stat-memphis {
    @apply pt-4 border-t-2 border-dashed border-gray-200;
  }

  @media (prefers-color-scheme: dark) {
    .feature-stat-memphis {
      @apply border-gray-600;
    }
  }

.price-card-memphis {
  @apply relative;
}

.price-card-memphis.featured {
  @apply transform md:scale-105;
}

.popular-badge {
    @apply absolute -top-3 right-4 bg-yellow font-subheading font-bold text-xs px-4 py-1;
    color: var(--color-text);
    box-shadow: 3px 3px 0 var(--color-brown);
  }

.price-header-memphis {
  @apply flex items-center justify-between mb-4;
}

.price-badge {
  @apply font-subheading font-bold text-xs px-2 py-1 rounded-full;
}

.price-badge-blue {
  @apply bg-blue text-white;
}

.price-badge-yellow {
    @apply bg-yellow;
    color: var(--color-text);
  }

.price-badge-pink {
  @apply bg-pink text-white;
}

.price-amount-memphis {
  @apply mb-4;
}

.price-features-memphis {
  @apply list-none p-0 m-0 mb-6 space-y-2;
}

.price-features-memphis li {
  @apply flex items-center gap-2 font-body text-sm text-gray-600;
}

.price-features-memphis li i {
  @apply text-lg;
}

.cta-deco {
  @apply absolute pointer-events-none rounded-full;
}

.cta-deco-1 {
  @apply w-40 h-40 rounded-full bg-yellow;
  top: -20px;
  left: 10%;
  opacity: 0.15;
}

.cta-deco-2 {
  @apply w-24 h-24 rounded-full bg-pink;
  bottom: 20%;
  right: 15%;
  opacity: 0.1;
}

.cta-deco-3 {
  @apply w-16 h-16 rounded-full bg-blue;
  top: 40%;
  right: 5%;
  opacity: 0.12;
}
</style>