---
// ScooterCard.astro - Memphis style with bold colors and playful design
interface Props {
  id?: string;
  name: string;
  pricePerHour: number;
  specs: {
    speed: string;
    speedValue: string;
    battery: string;
    batteryValue: string;
    motor: string;
    motorValue: string;
    weight: string;
    weightValue: string;
  };
  batteryLevel?: number;
  available?: boolean;
  variant?: "pink" | "yellow" | "blue";
}

const {
  id = "scooter-1",
  name = "Scooter Pro X",
  pricePerHour = 15,
  specs = {
    speed: "Velocidad",
    speedValue: "45 km/h",
    battery: "Autonomía",
    batteryValue: "80 km",
    motor: "Motor",
    motorValue: "500W",
    weight: "Peso",
    weightValue: "18 kg",
  },
  batteryLevel = 85,
  available = true,
  variant = "pink",
} = Astro.props;

const getBatteryColor = (level: number) => {
  if (level >= 70) return "lime";
  if (level >= 30) return "yellow";
  return "coral";
};

const batteryColor = getBatteryColor(batteryLevel);

const variantColors = {
  pink: { border: "border-pink", icon: "text-pink", bg: "bg-pink" },
  yellow: { border: "border-yellow", icon: "text-yellow", bg: "bg-yellow" },
  blue: { border: "border-blue", icon: "text-blue", bg: "bg-blue" },
};

const currentVariant = variantColors[variant];
---

<article
  class:list={[
    "scooter-card-memphis",
    "border-4",
    "border-solid",
    currentVariant.border,
  ]}
  data-scooter-id={id}
  data-available={available}
>
  <!-- Decorative shapes -->
  <div class="card-shape card-shape-1"></div>
  <div class="card-shape card-shape-2"></div>

  <!-- Header with name and status -->
  <div class="card-header">
    <h3 class="scooter-name">{name}</h3>
    <span class:list={["status-badge", available ? "status-available" : "status-busy"]}>
      {available ? "DISPONIBLE" : "EN USO"}
    </span>
  </div>

  <!-- Scooter SVG Illustration -->
  <div class="scooter-illustration">
    <svg viewBox="0 0 200 120" class="scooter-svg">
      <!-- Wheel back -->
      <circle cx="40" cy="90" r="25" fill="none" stroke="currentColor" stroke-width="4" class={currentVariant.icon}/>
      <circle cx="40" cy="90" r="15" fill="none" stroke="currentColor" stroke-width="2"/>
      <circle cx="40" cy="90" r="5" fill="currentColor"/>

      <!-- Wheel front -->
      <circle cx="160" cy="90" r="25" fill="none" stroke="currentColor" stroke-width="4" class={currentVariant.icon}/>
      <circle cx="160" cy="90" r="15" fill="none" stroke="currentColor" stroke-width="2"/>
      <circle cx="160" cy="90" r="5" fill="currentColor"/>

      <!-- Body -->
      <path d="M40 90 L70 50 L130 50 L160 90" fill="none" stroke="currentColor" stroke-width="4" class={currentVariant.icon}/>

      <!-- Seat -->
      <ellipse cx="90" cy="45" rx="25" ry="8" fill="currentColor" class={currentVariant.icon}/>

      <!-- Handlebars -->
      <path d="M130 50 L140 30 L155 30" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
      <rect x="148" y="25" width="12" height="8" rx="2" fill="currentColor"/>

      <!-- Deck -->
      <rect x="50" y="95" width="100" height="8" rx="4" fill="currentColor" class={currentVariant.icon}/>

      <!-- Battery indicator on scooter -->
      <rect x="55" y="65" width="60" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="2"/>
      <rect x="57" y="67" width={batteryLevel * 0.56} height="8" rx="1" fill={batteryColor === "lime" ? "#39FF14" : batteryColor === "yellow" ? "#FFE135" : "#FF6B35"}/>
    </svg>

    <!-- Battery level text -->
    <div class="battery-info">
      <span class="battery-label">{batteryLevel}%</span>
      <span class="battery-text">batería</span>
    </div>
  </div>

  <!-- Specs Grid -->
  <div class="specs-grid">
    <div class="spec-item">
      <div class="spec-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
      </div>
      <span class="spec-value">{specs.speedValue}</span>
      <span class="spec-label">{specs.speed}</span>
    </div>

    <div class="spec-item">
      <div class="spec-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <rect x="2" y="7" width="18" height="10" rx="2"/>
          <path d="M22 11v2"/>
        </svg>
      </div>
      <span class="spec-value">{specs.batteryValue}</span>
      <span class="spec-label">{specs.battery}</span>
    </div>

    <div class="spec-item">
      <div class="spec-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="12" cy="12" r="3"/>
          <path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
        </svg>
      </div>
      <span class="spec-value">{specs.motorValue}</span>
      <span class="spec-label">{specs.motor}</span>
    </div>

    <div class="spec-item">
      <div class="spec-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
        </svg>
      </div>
      <span class="spec-value">{specs.weightValue}</span>
      <span class="spec-label">{specs.weight}</span>
    </div>
  </div>

  <!-- Footer with Price and CTA -->
  <div class="card-footer">
    <div class="price-display">
      <span class="price-value">${pricePerHour}</span>
      <span class="price-unit">/hora</span>
    </div>

    <a
      href="#reservar"
      class:list={["rent-btn", available ? "rent-btn-available" : "rent-btn-busy"]}
      aria-label={`Alquilar ${name}`}
    >
      {available ? "ALQUILAR" : "OCUPADO"}
    </a>
  </div>
</article>

<style>
.scooter-card-memphis {
  position: relative;
  overflow: hidden;
  background-color: var(--color-white);
  box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  border-radius: 0 !important;
}

.scooter-card-memphis:hover {
  transform: translateY(-4px) rotate(0.5deg);
  box-shadow: 12px 12px 0 rgba(0, 0, 0, 0.12);
}

.card-shape {
  position: absolute;
  pointer-events: none;
}

.card-shape-1 {
  width: 4rem;
  height: 4rem;
  border-radius: 9999px;
  background-color: #FF6B9D;
  top: -8px;
  right: -8px;
  opacity: 0.1;
}

.card-shape-2 {
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 9999px;
  background-color: #FFE135;
  bottom: 40px;
  left: -5px;
  opacity: 0.15;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem;
  border-bottom: 2px dashed;
  border-color: inherit;
}

.scooter-name {
  font-family: 'Fredoka One', cursive;
  font-size: 1.125rem;
  font-weight: bold;
  color: var(--color-text);
}

.status-badge {
  font-family: 'Baloo 2', sans-serif;
  font-weight: bold;
  font-size: 0.75rem;
  padding: 0.25rem 0.75rem;
  border-radius: 9999px;
}

.status-available {
  background-color: #39FF14;
  color: #1A1A2E;
}

.status-busy {
  background-color: #FF6B35;
  color: #FFFFFF;
}

.scooter-illustration {
  position: relative;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.scooter-svg {
  width: 100%;
  max-width: 20rem;
  color: var(--color-text);
}

.battery-info {
  position: absolute;
  bottom: 1rem;
  right: 1rem;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.battery-label {
  font-family: 'Fredoka One', cursive;
  font-size: 1.125rem;
  font-weight: bold;
  color: var(--color-text);
}

.battery-text {
  font-family: 'Nunito', sans-serif;
  font-size: 0.75rem;
  color: var(--color-gray-500);
}

.specs-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.5rem;
  padding: 1rem;
  background-color: var(--color-cream);
}

.spec-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0.5rem;
}

.spec-icon {
  width: 2rem;
  height: 2rem;
  margin-bottom: 0.25rem;
}

.spec-icon svg {
  width: 100%;
  height: 100%;
}

.spec-value {
  font-family: 'Fredoka One', cursive;
  font-size: 0.875rem;
  font-weight: bold;
  color: var(--color-text);
}

.spec-label {
  font-family: 'Nunito', sans-serif;
  font-size: 0.75rem;
  color: var(--color-gray-500);
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem;
  border-top: 2px dashed;
  border-color: inherit;
}

.price-display {
  display: flex;
  align-items: baseline;
  gap: 0.25rem;
}

.price-value {
  font-family: 'Fredoka One', cursive;
  font-size: 1.875rem;
  font-weight: bold;
  color: var(--color-text);
}

.price-unit {
  font-family: 'Nunito', sans-serif;
  font-size: 0.875rem;
  color: var(--color-gray-500);
}

.rent-btn {
  font-family: 'Baloo 2', sans-serif;
  font-weight: bold;
  font-size: 0.875rem;
  padding: 0.75rem 1.5rem;
  border: 4px solid;
  transition: all 0.2s ease;
}

.rent-btn-available {
  background-color: #FFE135;
  border-color: #8B4513;
  color: #2D2D2D;
}

.rent-btn-available:hover {
  transform: scale(1.05);
  box-shadow: 6px 6px 0 #8B4513;
}

.rent-btn-busy {
  background-color: #E5E7EB;
  border-color: #9CA3AF;
  color: #6B7280;
  cursor: not-allowed;
}

/* Dark Mode */
@media (prefers-color-scheme: dark) {
  .scooter-card-memphis {
    box-shadow: 8px 8px 0 rgba(255, 255, 255, 0.1);
  }

  .scooter-card-memphis:hover {
    box-shadow: 12px 12px 0 rgba(255, 255, 255, 0.12);
  }

  .status-available {
    background-color: #39FF14;
    color: #1A1A2E;
  }

  .specs-grid {
    background-color: rgba(255, 255, 255, 0.05);
  }

  .rent-btn-busy {
    background-color: #374151;
    border-color: #4B5563;
    color: #9CA3AF;
  }
}
</style>