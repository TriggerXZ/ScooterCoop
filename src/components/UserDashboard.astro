---
// UserDashboard.astro - Memphis style gamified dashboard
interface Props {
  user?: {
    name: string;
    level: number;
    totalCO2Saved: number;
    totalRoutes: number;
    totalKm: number;
  };
  recentRoutes?: {
    id: string;
    from: string;
    to: string;
    duration: number;
    distance: number;
    co2Saved: number;
    date: string;
    badge?: string;
  }[];
  achievements?: {
    id: string;
    name: string;
    icon: string;
    unlocked: boolean;
    description: string;
  }[];
}

const {
  user = {
    name: "Usuario",
    level: 5,
    totalCO2Saved: 12.5,
    totalRoutes: 45,
    totalKm: 280,
  },
  recentRoutes = [
    { id: "1", from: "Centro", to: "Playa", duration: 25, distance: 8, co2Saved: 2.0, date: "Hoy", badge: "🏆" },
    { id: "2", from: "Casa", to: "Trabajo", duration: 15, distance: 4, co2Saved: 1.0, date: "Ayer", badge: "⭐" },
    { id: "3", from: "Universidad", to: "Centro", duration: 20, distance: 6, co2Saved: 1.5, date: "Hace 2 días", badge: undefined },
  ],
  achievements = [
    { id: "1", name: "Eco Warrior", icon: "🌱", unlocked: true, description: "Ahorra 10kg de CO2" },
    { id: "2", name: "Speed Demon", icon: "⚡", unlocked: true, description: "Completa 50 rutas" },
    { id: "3", name: "100km Club", icon: "🚴", unlocked: true, description: "Recorre 100km" },
    { id: "4", name: "Maratonista", icon: "🏅", unlocked: false, description: "Completa un maratón" },
    { id: "5", name: "Veterano", icon: "⭐", unlocked: false, description: "Usa la app 30 días" },
    { id: "6", name: "Embajador", icon: "🌍", unlocked: false, description: "Invita 5 amigos" },
  ],
} = Astro.props;

const nextLevelCO2 = (user.level + 1) * 10;
const currentLevelCO2 = user.level * 10;
const progressToNext = ((user.totalCO2Saved - currentLevelCO2) / (nextLevelCO2 - currentLevelCO2)) * 100;
---

<section class="dashboard-memphis py-12 bg-cream">
  <div class="max-w-7xl mx-auto px-4">
    <!-- Header -->
    <div class="dashboard-header mb-8">
      <div class="header-deco header-deco-1"></div>
      <div class="header-deco header-deco-2"></div>

      <h2 class="dashboard-title">
        ¡Hola, {user.name}!
        <span class="wave-icon">👋</span>
      </h2>
      <p class="dashboard-subtitle">Tu impacto ambiental este mes</p>
    </div>

    <!-- Impact Stats - Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <!-- CO2 Saved -->
      <div class="stat-card-memphis stat-card-lime">
        <div class="stat-icon-wrapper">
          <div class="stat-icon-bg"></div>
          <div class="stat-icon-inner">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
        </div>
        <div class="stat-content">
          <p class="stat-label">CO2 Ahorrado</p>
          <p class="stat-value text-lime">{user.totalCO2Saved.toFixed(1)} kg</p>
        </div>
        <div class="stat-trend">
          <span class="trend-badge trend-up">↑ 15%</span>
          <span class="trend-text">vs mes anterior</span>
        </div>
      </div>

      <!-- Routes -->
      <div class="stat-card-memphis stat-card-pink">
        <div class="stat-icon-wrapper">
          <div class="stat-icon-bg"></div>
          <div class="stat-icon-inner">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </div>
        </div>
        <div class="stat-content">
          <p class="stat-label">Rutas Totales</p>
          <p class="stat-value text-pink">{user.totalRoutes}</p>
        </div>
        <div class="stat-trend">
          <span class="level-badge">Nivel {user.level}</span>
        </div>
      </div>

      <!-- Distance -->
      <div class="stat-card-memphis stat-card-blue">
        <div class="stat-icon-wrapper">
          <div class="stat-icon-bg"></div>
          <div class="stat-icon-inner">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </div>
        </div>
        <div class="stat-content">
          <p class="stat-label">Distancia Total</p>
          <p class="stat-value text-blue">{user.totalKm} km</p>
        </div>
        <div class="stat-trend">
          <span class="trees-badge">🚴 {user.totalKm / 5} árboles</span>
        </div>
      </div>
    </div>

    <!-- Level Progress -->
    <div class="progress-card-memphis">
      <div class="progress-header">
        <div class="progress-title-wrapper">
          <div class="trophy-icon">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm6-6H6c-1.1 0-2 .9-2 2v2c0 2.76 2.24 5 5 5h.26c.83 1.82 2.63 3 4.74 3 1.82 0 3.46-.92 4.39-2.33l.35-.59V4c0-1.1-.9-2-2-2zM6 6h12v1.1c-.68.54-1.3 1.12-1.82 1.77l-.26.33c-.59.74-1.08 1.56-1.43 2.46-.16-.01-.32-.03-.49-.03H7.7c-.36-.9-.87-1.7-1.47-2.4L6 6.1V6zm12 10H6c-2.21 0-4-1.79-4-4v-2h16v2c0 2.21-1.79 4-4 4z"/>
            </svg>
          </div>
          <div>
            <h3 class="progress-title">Nivel {user.level}</h3>
            <p class="progress-meta">Meta: {nextLevelCO2} kg CO2</p>
          </div>
        </div>
        <span class="progress-percentage">{Math.min(progressToNext, 100).toFixed(0)}%</span>
      </div>

      <div class="progress-bar-memphis">
        <div
          class="progress-fill"
          style={`width: ${Math.min(progressToNext, 100)}%`}
        ></div>
      </div>

      <p class="progress-footer">
        {(nextLevelCO2 - user.totalCO2Saved).toFixed(1)} kg más para el siguiente nivel
      </p>
    </div>

    <!-- Recent Routes -->
    <div class="routes-card-memphis">
      <h3 class="section-subtitle-memphis">Rutas Recientes</h3>
      <div class="routes-list">
        {recentRoutes.map((route, index) => (
          <div class="route-item-memphis" style={`animation-delay: ${index * 50}ms`}>
            <div class="route-map-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div class="route-details">
              <p class="route-path">{route.from} → {route.to}</p>
              <p class="route-stats">
                {route.duration} min • {route.distance} km • -{route.co2Saved} kg CO2
              </p>
            </div>
            <div class="route-meta">
              {route.badge && <span class="route-badge">{route.badge}</span>}
              <span class="route-date">{route.date}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Achievements -->
    <div class="achievements-card-memphis">
      <h3 class="section-subtitle-memphis">Logros Desbloqueados</h3>
      <div class="achievements-grid">
        {achievements.map((achievement, index) => (
          <div
            class:list={[
              "achievement-item-memphis",
              achievement.unlocked ? "achievement-unlocked" : "achievement-locked",
            ]}
            title={achievement.description}
            style={`animation-delay: ${index * 50}ms`}
          >
            <span class="achievement-icon">{achievement.icon}</span>
            <span class="achievement-name">{achievement.name}</span>
            {achievement.unlocked && <div class="achievement-shine"></div>}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.dashboard-memphis {
  @apply relative;
}

.dashboard-header {
  @apply relative;
}

.header-deco {
  @apply absolute pointer-events-none;
}

.header-deco-1 {
  @apply w-20 h-20 rounded-full bg-yellow;
  top: -10px;
  left: -20px;
  opacity: 0.25;
}

.header-deco-2 {
  @apply w-12 h-12 rounded-full bg-pink;
  top: 0;
  right: 20%;
  opacity: 0.2;
}

.dashboard-title {
  @apply font-heading text-3xl font-bold text-text relative z-10;
}

.wave-icon {
  @apply inline-block animate-wiggle;
}

.dashboard-subtitle {
  @apply font-body text-gray-500;
}

/* Stat Cards */
  .stat-card-memphis {
    @apply bg-white border-4 border-solid p-6 relative overflow-hidden;
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.08);
    animation: drop-in 0.4s ease-out backwards;
    transition: all 0.3s ease;
    border-radius: 0 !important;
  }

  @media (prefers-color-scheme: dark) {
    .stat-card-memphis {
      box-shadow: 6px 6px 0 rgba(255, 255, 255, 0.1);
    }

    .stat-card-memphis:hover {
      box-shadow: 8px 8px 0 rgba(255, 255, 255, 0.12);
    }
  }

.stat-card-memphis:hover {
  transform: translateY(-4px) rotate(0.5deg);
}

.stat-card-lime {
  @apply border-lime;
}

.stat-card-pink {
  @apply border-pink;
}

.stat-card-blue {
  @apply border-blue;
}

.stat-icon-wrapper {
  @apply relative w-16 h-16 mb-4;
}

.stat-icon-bg {
  @apply absolute inset-0 rounded-full;
}

.stat-card-lime .stat-icon-bg {
  @apply bg-lime;
  opacity: 0.15;
}

.stat-card-pink .stat-icon-bg {
  @apply bg-pink;
  opacity: 0.15;
}

.stat-card-blue .stat-icon-bg {
  @apply bg-blue;
  opacity: 0.15;
}

.stat-icon-inner {
  @apply relative w-16 h-16 rounded-full bg-white border-4 border-solid flex items-center justify-center;
}

.stat-card-lime .stat-icon-inner {
  @apply border-lime text-lime;
}

.stat-card-pink .stat-icon-inner {
  @apply border-pink text-pink;
}

.stat-card-blue .stat-icon-inner {
  @apply border-blue text-blue;
}

.stat-icon-inner svg {
  @apply w-8 h-8;
}

.stat-content {
  @apply mb-2;
}

.stat-label {
  @apply font-body text-sm text-gray-500 mb-1;
}

.stat-value {
  @apply font-heading text-3xl font-bold;
}

.stat-trend {
  @apply flex items-center gap-2;
}

.trend-badge {
  @apply font-subheading font-bold text-xs px-2 py-1 rounded-full;
}

.trend-up {
  @apply bg-lime text-dark;
}

.level-badge {
  @apply font-subheading font-bold text-xs px-2 py-1 rounded-full bg-pink text-white;
}

.trees-badge {
  @apply font-body text-xs text-gray-500;
}

/* Progress Card */
  .progress-card-memphis {
    @apply bg-white border-4 border-yellow p-6 mb-8;
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.08);
    border-radius: 0 !important;
  }

  @media (prefers-color-scheme: dark) {
    .progress-card-memphis {
      box-shadow: 6px 6px 0 rgba(255, 255, 255, 0.1);
    }
  }

.progress-header {
  @apply flex items-center justify-between mb-4;
}

.progress-title-wrapper {
  @apply flex items-center gap-3;
}

.trophy-icon {
  @apply w-12 h-12 rounded-full bg-yellow flex items-center justify-center;
}

.trophy-icon svg {
  @apply w-7 h-7 text-text;
}

.progress-title {
  @apply font-heading text-xl font-bold text-text;
}

.progress-meta {
  @apply font-body text-sm text-gray-500;
}

.progress-percentage {
  @apply font-heading text-3xl font-bold text-pink;
}

.progress-bar-memphis {
  @apply h-4 bg-cream rounded-full overflow-hidden;
  box-shadow: inset 2px 2px 4px rgba(0, 0, 0, 0.1);
}

.progress-fill {
  @apply h-full bg-gradient-to-r from-yellow via-pink to-lime rounded-full;
  transition: width 0.5s ease;
}

.progress-footer {
  @apply font-body text-sm text-gray-500 mt-3;
}

/* Routes Card */
  .routes-card-memphis {
    @apply bg-white border-4 border-blue p-6 mb-8;
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.08);
    border-radius: 0 !important;
  }

  @media (prefers-color-scheme: dark) {
    .routes-card-memphis {
      box-shadow: 6px 6px 0 rgba(255, 255, 255, 0.1);
    }
  }

.section-subtitle-memphis {
  @apply font-heading text-lg font-bold text-text mb-4;
}

.routes-list {
  @apply space-y-3;
}

.route-item-memphis {
  @apply flex items-center gap-4 p-4 bg-cream rounded-lg;
  animation: slide-in 0.4s ease-out backwards;
  transition: all 0.2s ease;
}

.route-item-memphis:hover {
  transform: translateX(4px);
}

.route-map-icon {
  @apply w-10 h-10 rounded-full bg-blue flex items-center justify-center text-white;
}

.route-map-icon svg {
  @apply w-6 h-6;
}

.route-details {
  @apply flex-1;
}

.route-path {
  @apply font-subheading font-bold text-text;
}

.route-stats {
  @apply font-body text-sm text-gray-500;
}

.route-meta {
  @apply flex items-center gap-2;
}

.route-badge {
  @apply text-xl;
}

.route-date {
  @apply font-body text-xs text-gray-400;
}

/* Achievements Card */
  .achievements-card-memphis {
    @apply bg-white border-4 border-purple p-6;
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.08);
    border-radius: 0 !important;
  }

  @media (prefers-color-scheme: dark) {
    .achievements-card-memphis {
      box-shadow: 6px 6px 0 rgba(255, 255, 255, 0.1);
    }

    .achievement-locked {
      @apply bg-gray-800 border-gray-700;
    }
  }

.achievements-grid {
  @apply grid grid-cols-3 md:grid-cols-6 gap-4;
}

.achievement-item-memphis {
  @apply flex flex-col items-center p-4 rounded-xl relative overflow-hidden;
  transition: all 0.3s ease;
}

.achievement-unlocked {
  @apply bg-gradient-to-br from-lime/10 to-transparent border-2 border-lime;
  animation: pop-in 0.3s ease-out backwards;
}

.achievement-locked {
  @apply bg-gray-100 border-2 border-gray-200 opacity-50;
}

.achievement-item-memphis:hover {
  transform: scale(1.05);
}

.achievement-icon {
  @apply text-3xl mb-2;
}

.achievement-name {
  @apply font-subheading font-semibold text-xs text-center;
}

.achievement-unlocked .achievement-name {
  @apply text-text;
}

.achievement-locked .achievement-name {
  @apply text-gray-400;
}

.achievement-shine {
  @apply absolute inset-0 pointer-events-none;
  background: linear-gradient(135deg, transparent 40%, rgba(255,255,255,0.3) 50%, transparent 60%);
}

@keyframes drop-in {
  0% { transform: translateY(-20px); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

@keyframes slide-in {
  0% { transform: translateX(-10px); opacity: 0; }
  100% { transform: translateX(0); opacity: 1; }
}

@keyframes pop-in {
  0% { transform: scale(0.8); opacity: 0; }
  70% { transform: scale(1.1); }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes wiggle {
  0%, 100% { transform: rotate(-10deg); }
  50% { transform: rotate(10deg); }
}
</style>