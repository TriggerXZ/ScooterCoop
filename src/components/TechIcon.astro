---
// TechIcon.astro - Memphis style SVG icons with playful design
interface Props {
  name: string;
  size?: "sm" | "md" | "lg" | "xl";
  variant?: "pink" | "yellow" | "blue" | "lime" | "text";
  animated?: boolean;
  className?: string;
}

const {
  name = "battery",
  size = "md",
  variant = "pink",
  animated = false,
  className = "",
} = Astro.props;

const sizes = {
  sm: "w-5 h-5",
  md: "w-6 h-6",
  lg: "w-8 h-8",
  xl: "w-12 h-12",
};

const colors = {
  pink: "#FF6B9D",
  yellow: "#FFE135",
  blue: "#00ADEE",
  lime: "#39FF14",
  text: "#2D2D2D",
};

const currentSize = sizes[size];
const currentColor = colors[variant];

const icons: Record<string, string> = {
  battery: `<rect x="2" y="7" width="18" height="10" rx="2" stroke="currentColor" stroke-width="2.5" fill="none"/><path d="M22 11v2" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>`,
  speed: `<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" fill="none"/><path d="M12 7v5l3 3" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>`,
  motor: `<rect x="3" y="8" width="18" height="8" rx="2" stroke="currentColor" stroke-width="2.5" fill="none"/><circle cx="7" cy="12" r="2" stroke="currentColor" stroke-width="2.5" fill="none"/><circle cx="17" cy="12" r="2" stroke="currentColor" stroke-width="2.5" fill="none"/><line x1="9" y1="12" x2="15" y2="12" stroke="currentColor" stroke-width="2.5"/>`,
  wifi: `<path d="M5 13c3-4 8-4 11 0M9 17c2-2 5-2 7 0" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/><circle cx="12" cy="20" r="2" fill="currentColor"/>`,
  bluetooth: `<path d="M12 2L6 8l6 6 6-6-6-6z" stroke="currentColor" stroke-width="2.5" fill="none"/><line x1="9" y1="8" x2="15" y2="14" stroke="currentColor" stroke-width="2.5"/><line x1="15" y1="8" x2="9" y2="14" stroke="currentColor" stroke-width="2.5"/>`,
  gps: `<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" fill="none"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2.5" fill="none"/><line x1="12" y1="3" x2="12" y2="6" stroke="currentColor" stroke-width="2.5"/><line x1="12" y1="18" x2="12" y2="21" stroke="currentColor" stroke-width="2.5"/>`,
  charging: `<path d="M13 2L6 7h5v11h2V7h5L13 2z" stroke="currentColor" stroke-width="2.5" fill="none"/><path d="M16 14l3 3 3-3" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  map: `<rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2.5" fill="none"/><path d="M3 9h18M9 3v18" stroke="currentColor" stroke-width="1.5"/>`,
  shield: `<path d="M12 2L3 7v6c0 5.5 4 10 9 13 5-3 9-7.5 9-13V7l-9-5z" stroke="currentColor" stroke-width="2.5" fill="none"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  check: `<path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  star: `<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2.5" fill="none"/>`,
  user: `<circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2.5" fill="none"/><path d="M4 20c0-4 4-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round"/>`,
  clock: `<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" fill="none"/><path d="M12 7v5l3 3" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  location: `<path d="M12 2C8 2 5 5 5 9c0 5 7 11 7 11s7-6 7-11c0-4-3-7-7-7z" stroke="currentColor" stroke-width="2.5" fill="none"/><circle cx="12" cy="9" r="3" stroke="currentColor" stroke-width="2.5" fill="none"/>`,
  phone: `<rect x="5" y="2" width="14" height="20" rx="3" stroke="currentColor" stroke-width="2.5" fill="none"/><circle cx="12" cy="18" r="1.5" fill="currentColor"/>`,
  email: `<rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="2.5" fill="none"/><path d="M3 7l9 6 9-6" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  menu: `<line x1="4" y1="6" x2="20" y2="6" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><line x1="4" y1="12" x2="20" y2="12" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><line x1="4" y1="18" x2="20" y2="18" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>`,
  close: `<line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>`,
  chevron: `<path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  gear: `<circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2.5" fill="none"/><path d="M12 1v4M12 19v4M4.2 4.2l2.8 2.8M16.9 16.9l2.8 2.8M4.2 19.8l2.8-2.8M16.9 7.1l2.8-2.8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>`,
  terminal: `<rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="2.5" fill="none"/><path d="M6 9l3 3-3 3" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/><line x1="12" y1="15" x2="18" y2="15" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>`,
  code: `<path d="M16 18l6-6-6-6M8 6l-6 6 6 6" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  zap: `<path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  scooter: `<circle cx="7" cy="17" r="3" stroke="currentColor" stroke-width="2.5" fill="none"/><circle cx="17" cy="17" r="3" stroke="currentColor" stroke-width="2.5" fill="none"/><path d="M5 14h4l1-6h6l1 3" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 8h6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><rect x="14" y="4" width="8" height="5" rx="1" fill="currentColor"/>`,
  home: `<path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" stroke="currentColor" stroke-width="2.5" fill="none"/><path d="M9 22V12h6v10" stroke="currentColor" stroke-width="2.5" fill="none"/>`,
  support: `<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2.5" fill="none"/><path d="M9 9a3 3 0 115.83 1c0 2-3 3-3 3M12 17h.01" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round"/>`,
  calendar: `<rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2.5" fill="none"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>`,
  camera: `<path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2v11z" stroke="currentColor" stroke-width="2.5" fill="none"/><circle cx="12" cy="13" r="4" stroke="currentColor" stroke-width="2.5" fill="none"/>`,
  gift: `<path d="M20 12v10H4V12M2 7h20v5H2V7z" stroke="currentColor" stroke-width="2.5" fill="none"/><path d="M12 22V7M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z" stroke="currentColor" stroke-width="2.5" fill="none"/>`,
  group: `<circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="2.5" fill="none"/><path d="M3 21v-2a4 4 0 014-4h4a4 4 0 014 4v2" stroke="currentColor" stroke-width="2.5" fill="none"/><circle cx="17" cy="10" r="3" stroke="currentColor" stroke-width="2.5" fill="none"/><path d="M21 21v-2a3 3 0 00-3-3h-1" stroke="currentColor" stroke-width="2.5" fill="none"/>`,
};

const svgContent = icons[name] || icons.battery;
---

<div
  class:list={[
    "tech-icon-memphis inline-flex items-center justify-center",
    currentSize,
    animated && "animate-wiggle",
    className,
  ]}
>
  <svg
    viewBox="0 0 24 24"
    style={`color: ${currentColor}`}
    stroke="currentColor"
    fill="none"
  >
    <Fragment set:html={svgContent} />
  </svg>
</div>

<style>
.tech-icon-memphis {
  transition: all 0.2s ease;
}

.tech-icon-memphis:hover {
  transform: scale(1.2) rotate(5deg);
}
</style>